msgstr "Glaçaileron"

#. source : patch FR actuel
#: src/data/pokemon/species_info/gen_9_families.h:6432
msgid ""
"This Pokémon lives in forests and\\ncraggy areas. Using the power of "
"its\\ndorsal fin, it cools the inside of its\\nnest like a refrigerator."
msgstr ""
"Il vit dans les forêts et les zones\\nescarpées. Grâce à sa "
"nageoire\\ndorsale, il rafraîchit son nid\\ncomme un réfrigérateur."

#. source : patch FR actuel
#: src/data/pokemon/species_info/gen_9_families.h:6491
msgid "ARCTIBAX"
msgstr "CRYODO"

#. source : patch FR actuel
#: src/data/pokemon/species_info/gen_9_families.h:6497
msgid ""
"Arctibax freezes the air around it,\\nprotecting its face with an ice\\nmask"
" and turning its dorsal fin into a\\nblade of ice."
msgstr ""
"Cryodo gèle l’air autour de lui pour\\nprotéger son visage d’un masque "
"de\\nglace et changer sa nageoire dorsale\\nen lame gelée."

#. source : patch FR actuel
#: src/data/pokemon/species_info/gen_9_families.h:6555
#: src/data/pokemon/species_info/gen_9_families.h:6621
msgid "BAXCALIBUR"
msgstr "GLAIVODO"

#. source : patch FR actuel
#: src/data/pokemon/species_info/gen_9_families.h:6558
#: src/data/pokemon/species_info/gen_9_families.h:6628
msgid "Ice Dragon"
msgstr "Dragon Glace"

#. source : patch FR actuel
#: src/data/pokemon/species_info/gen_9_families.h:6561
