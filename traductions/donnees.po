#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7263
msgid "CHARGE"
msgstr "Chargeur"

#. source : patch FR actuel
#: src/data/moves_info.h:7264
msgid "Charges power to boost the\\nElectric move used next."
msgstr "Se charge pour booster la\\nprochaine capacité Électrik."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7289
msgid "TAUNT"
msgstr "Provoc"

#. source : patch FR actuel
#: src/data/moves_info.h:7290
msgid "Taunts the foe into only\\nusing attack moves."
msgstr "Provoque l’ennemi. L’oblige\\nà utiliser ses attaques."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7315
msgid "HELPING HAND"
msgstr "Coup d’Main"

#. source : patch FR actuel
#: src/data/moves_info.h:7316
msgid "Boosts the power of ally\\nrecipient's moves."
msgstr "Augmente la puissance des\\ncapacités d’un allié."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7344
msgid "TRICK"
msgstr "Tourmagik"

#. source : patch FR actuel
#: src/data/moves_info.h:7345
msgid "Tricks the foe into trading\\nheld items."
msgstr "Oblige la cible à échanger\\nles objets tenus."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7370
msgid "ROLE PLAY"
msgstr "Imitation"

#. source : patch FR actuel
#: src/data/moves_info.h:7371
msgid "Mimics the target and\\ncopies its Ability."
msgstr "Imite la cible et copie\\nson talent."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7396
msgid "WISH"
msgstr "Voeu"

#. source : patch FR actuel
#: src/data/moves_info.h:7397
msgid "A wish that restores HP.\\nIt takes time to work."
msgstr "Un vœu qui restaure les PV.\\nDemande un certain temps."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7423
msgid "ASSIST"
msgstr "Assistance"

#. source : patch FR actuel
#: src/data/moves_info.h:7424
msgid "Attacks randomly with one\\nof the partner's moves."
msgstr "Attaque au hasard avec un\\ncoup d’un des partenaires."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7454
msgid "INGRAIN"
msgstr "Racines"

#. source : patch FR actuel
#: src/data/moves_info.h:7455
msgid "Lays roots that restore HP.\\nThe user can't switch out."
msgstr "Plante des racines, regagne\\nPV, ne peut plus changer."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7481
msgid "SUPERPOWER"
msgstr "Surpuissance"

#. source : patch FR actuel
#: src/data/moves_info.h:7482
msgid "Boosts strength sharply,\\nbut lowers abilities."
msgstr "Booste la force, mais\\nbaisse les capacités."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7508
msgid "MAGIC COAT"
msgstr "Reflet Magik"

#. source : patch FR actuel
#: src/data/moves_info.h:7509
msgid "Reflects special effects\\nback to the attacker."
msgstr "Renvoie les effets\\nspéciaux vers le lanceur."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7533
msgid "RECYCLE"
msgstr "Recyclage"

#. source : patch FR actuel
#: src/data/moves_info.h:7534
msgid "Recycles a used item for\\none more use."
msgstr "Recycle un objet pour\\nl’utiliser une fois de plus."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7559
msgid "REVENGE"
msgstr "Vendetta"

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7580
msgid "BRICK BREAK"
msgstr "Casse-Brique"

#. source : patch FR actuel
#: src/data/moves_info.h:7581
msgid "Destroys barriers such as\\nREFLECT and causes damage."
msgstr "Détruit les barrières comme\\nPROTECTION et blesse."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7607
msgid "YAWN"
msgstr "Bâillement"

#. source : patch FR actuel
#: src/data/moves_info.h:7608
msgid "Lulls the foe into yawning,\\nthen sleeping next turn."
msgstr "Fait bâiller l’ennemi, qui\\ns’endort au tour suivant."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7632
msgid "KNOCK OFF"
msgstr "Sabotage"

#. source : patch FR actuel
#: src/data/moves_info.h:7633
msgid "Knocks down the foe's held\\nitem to prevent its use."
msgstr "Frappe l’objet tenu pour\\nle rendre inutilisable."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7655
msgid "ENDEAVOR"
msgstr "Effort"

#. source : patch FR actuel
#: src/data/moves_info.h:7656
msgid "Cuts foe's HP to equal\\nuser's HP."
msgstr "Réduit les PV de l’ennemi\\nà ceux du lanceur."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7679
msgid "ERUPTION"
msgstr "Eruption"

#. source : patch FR actuel
#: src/data/moves_info.h:7680
msgid "The higher the user's HP,\\nthe more damage caused."
msgstr "Inflige plus de dégâts si PV\\ndu lanceur sont élevés."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7701
msgid "SKILL SWAP"
msgstr "Echange"

#. source : patch FR actuel
#: src/data/moves_info.h:7702
msgid "The user swaps special\\nabilities with the target."
msgstr "Le lanceur et la cible\\néchangent leurs cap. spéc."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7725
msgid "IMPRISON"
msgstr "Possessif"

#. source : patch FR actuel
#: src/data/moves_info.h:7726
msgid "Prevents foes from using\\nmoves known by the user."
msgstr "Empêche les ennemis d’uti-\\nliser les coups du lanceur."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7753
msgid "REFRESH"
msgstr "Régénération"

#. source : patch FR actuel
#: src/data/moves_info.h:7754
msgid "Heals poisoning, paralysis,\\nor a burn."
msgstr "Soigne un empoisonnement,\\nune paralysie, une brûlure."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7779
msgid "GRUDGE"
msgstr "Rancune"

#. source : patch FR actuel
#: src/data/moves_info.h:7780
msgid "If the user faints, deletes\\nall PP of foe's last move."
msgstr "Si mis K.O., supprime les PP\\ndu dernier coup ennemi."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7805
msgid "SNATCH"
msgstr "Saisie"

#. source : patch FR actuel
#: src/data/moves_info.h:7806
msgid "Steals the effects of the\\nmove the target uses next."
msgstr "Vole les effets de la pro-\\nchaine attaque de la cible."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7835
msgid "SECRET POWER"
msgstr "Force Cachée"

#. source : patch FR actuel
#: src/data/moves_info.h:7836
msgid "Attack with effects\\nthat vary by location."
msgstr "L’effet varie selon\\nle lieu du combat."

#. source : Émeraude FR officiel
#: src/data/moves_info.h:7861
msgid "DIVE"
msgstr "Plongée"

#. source : patch FR actuel
#: src/data/moves_info.h:7862
msgid "Dives underwater the first\\nturn and strikes next turn."
msgstr "Plonge en apnée au premier\\ntour et frappe au second."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7889
msgid "ARM THRUST"
msgstr "Cogne"

#. source : patch FR actuel
#: src/data/moves_info.h:7890
msgid "Straight-arm punches that\\nstrike the foe 2 to 5 times."
msgstr "Coups de poing arrêtés qui\\nfrappent 2 à 5 fois."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7912
msgid "CAMOUFLAGE"
msgstr "Camouflage"

#. source : patch FR actuel
#: src/data/moves_info.h:7913
msgid "Alters the Pokémon's type\\ndepending on the location."
msgstr "Change le type du Pokémon\\nselon le lieu."

#. source : SoulSilver FR officiel
#. patch FR actuel : LUMI-QUEUE
#: src/data/moves_info.h:7938
msgid "TAIL GLOW"
msgstr "Lumiqueue"

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7968
msgid "LUSTER PURGE"
msgstr "Lumi-Eclat"

#. source : patch FR actuel
#: src/data/moves_info.h:7969
msgid "Attacks with a burst of\\nlight. May lower Sp. Def."
msgstr "Envoie une lueur intense.\\nPeut baisser Déf. Spé."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:7994
msgid "MIST BALL"
msgstr "Ball’Brume"

#. source : patch FR actuel
#: src/data/moves_info.h:7995
msgid "Attacks with a flurry of\\ndown. May lower Sp. Atk."
msgstr "Envoie une rafale de duvet.\\nPeut baisser Atq. Spé."

#. source : patch FR actuel
#. SoulSilver (approché) : Danse-Plume
#: src/data/moves_info.h:8021
msgid "FEATHER DANCE"
msgstr "DANSE PLUMES"

#. source : patch FR actuel
#: src/data/moves_info.h:8022
msgid "Envelops the foe with down\\nto sharply reduce Attack."
msgstr "Enveloppe l’ennemi de duvet\\net baisse l’Attaque."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8046
msgid "TEETER DANCE"
msgstr "Danse-Folle"

#. source : patch FR actuel
#: src/data/moves_info.h:8047
msgid "Confuses all Pokémon on\\nthe scene."
msgstr "Rend tous les Pokémon\\nengagés confus."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8071
msgid "BLAZE KICK"
msgstr "Pied Brûleur"

#. source : patch FR actuel
#: src/data/moves_info.h:8072
msgid "A kick with a high critical-\\nhit ratio. May cause a burn."
msgstr "Coup de pied à taux de cri-\\ntiques élevé. Peut brûler."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8099
msgid "MUD SPORT"
msgstr "Lance-Boue"

#. source : patch FR actuel
#: src/data/moves_info.h:8100
msgid "Covers the user in mud to\\nweaken all Electric moves."
msgstr "Se couvre de boue pour affaiblir\\nles capacités Électrik."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8126
msgid "ICE BALL"
msgstr "Ball’Glace"

#. source : patch FR actuel
#: src/data/moves_info.h:8127
msgid "A 5-turn attack that gains\\npower on successive hits."
msgstr "Une attaque en 5 tours de\\nplus en plus puissante."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8151
msgid "NEEDLE ARM"
msgstr "Poing Dard"

#. source : patch FR actuel
#: src/data/moves_info.h:8152
msgid "Attacks with thorny arms.\\nMay cause flinching."
msgstr "Attaque avec des bras\\népineux. Peut apeurer."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8179
msgid "SLACK OFF"
msgstr "Paresse"

#. source : patch FR actuel
#: src/data/moves_info.h:8180
msgid "Slacks off and restores\\nhalf the maximum HP."
msgstr "Se détend et récupère\\nla moitié des PV maximum."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8206
msgid "HYPER VOICE"
msgstr "Mégaphone"

#. source : patch FR actuel
#: src/data/moves_info.h:8207
msgid "A loud attack that uses\\nsound waves to injure."
msgstr "Attaque bruyante blessant\\navec des ondes sonores."

#. source : SoulSilver FR officiel
#. patch FR actuel : CROCHET VENIN
#: src/data/moves_info.h:8230
msgid "POISON FANG"
msgstr "Crochetvenin"

#. source : patch FR actuel
#: src/data/moves_info.h:8231
msgid "A sharp-fanged attack.\\nMay badly poison the foe."
msgstr "Morsure pouvant sérieuse-\\nment empoisonner l’ennemi."

#. source : SoulSilver FR officiel
#. patch FR actuel : ECLATE Griffe
#: src/data/moves_info.h:8257
msgid "CRUSH CLAW"
msgstr "Eclategriffe"

#. source : patch FR actuel
#: src/data/moves_info.h:8258
msgid "Tears at the foe with sharp\\nclaws. May lower Defense."
msgstr "Lacère avec des griffes.\\nPeut baisser la Défense."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8284
msgid "BLAST BURN"
msgstr "Rafale Feu"

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8310
msgid "HYDRO CANNON"
msgstr "Hydroblast"

#. source : SoulSilver FR officiel
#. patch FR actuel : POING METEORE
#: src/data/moves_info.h:8336
msgid "METEOR MASH"
msgstr "Poing Météor"

#. source : patch FR actuel
#: src/data/moves_info.h:8337
msgid "Fires a meteor-like punch.\\nMay raise Attack."
msgstr "Coup de poing météore.\\nPeut augmenter l’Attaque."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8365
msgid "ASTONISH"
msgstr "Etonnement"

#. source : patch FR actuel
#: src/data/moves_info.h:8366
msgid "Attack that may shock\\nthe foe into flinching."
msgstr "Peut surprendre l’ennemi\\net l’apeurer."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8393
msgid "WEATHER BALL"
msgstr "Ball’Météo"

#. source : patch FR actuel
#: src/data/moves_info.h:8394
msgid "The move's type and power\\nchange with the weather."
msgstr "Type et puissance de\\nl’attaque selon le climat."

#. source : SoulSilver FR officiel
#. patch FR actuel : AROMATHERAPIE
#: src/data/moves_info.h:8417
msgid "AROMATHERAPY"
msgstr "Aromathérapi"

#. source : patch FR actuel
#: src/data/moves_info.h:8418
msgid "Heals all status problems\\nwith a soothing scent."
msgstr "Parfum apaisant soignant\\nles changements de statut."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8444
msgid "FAKE TEARS"
msgstr "Croco Larme"

#. source : patch FR actuel
#: src/data/moves_info.h:8445
msgid "Feigns crying to sharply\\nlower the foe's Sp. Def."
msgstr "Fait semblant de pleurer\\npour baisser la Déf. Spé."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8468
msgid "AIR CUTTER"
msgstr "Tranch’Air"

#. source : patch FR actuel
#: src/data/moves_info.h:8469
msgid "Hacks with razorlike wind.\\nHigh critical-hit ratio."
msgstr "Un vent tranchant.\\nTaux de critiques élevé."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8493
msgid "OVERHEAT"
msgstr "Surchauffe"

#. source : patch FR actuel
#: src/data/moves_info.h:8494 src/data/moves_info.h:9499
msgid "Allows a full-power attack,\\nbut sharply lowers Sp. Atk."
msgstr "Attaque à pleine puissance,\\nmais baisse Atq. Spé."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8520
msgid "ODOR SLEUTH"
msgstr "Flair"

#. source : patch FR actuel
#: src/data/moves_info.h:8521
msgid "Negate evasiveness and\\nGhost type's immunities."
msgstr "Ignore l’Esquive et les\\nimmunités Spectre."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8545
msgid "ROCK TOMB"
msgstr "Tomberoche"

#. source : patch FR actuel
#: src/data/moves_info.h:8546
msgid "Stops the foe from moving\\nwith rocks and cuts Speed."
msgstr "Immobilise l’ennemi avec des\\nrochers. Baisse la Vitesse."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8571
msgid "SILVER WIND"
msgstr "Vent Argenté"

#. source : patch FR actuel
#: src/data/moves_info.h:8572
msgid "A powdery attack that may\\nraise abilities."
msgstr "Attaque poudreuse qui peut\\naugmenter les capacités."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8599
msgid "METAL SOUND"
msgstr "Strido-Son"

#. source : patch FR actuel
#: src/data/moves_info.h:8600
msgid "Emits a horrible screech\\nthat sharply lowers Sp. Def."
msgstr "Cri horrible qui baisse la\\nDéf. Spé. énormément."

#. source : patch FR actuel
#. SoulSilver (approché) : Siffl’Herbe
#: src/data/moves_info.h:8625
msgid "GRASS WHISTLE"
msgstr "Siffl’Herbe"

#. source : patch FR actuel
#: src/data/moves_info.h:8626
msgid "Lulls the foe into sleep\\nwith a pleasant melody."
msgstr "Endort l’ennemi en sifflant\\nune douce mélodie."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8652
msgid "TICKLE"
msgstr "Chatouille"

#. source : patch FR actuel
#: src/data/moves_info.h:8653
msgid "Makes the foe laugh to\\nlower Attack and Defense."
msgstr "Fait rire l’ennemi et baisse\\nson Attaque et sa Défense."

#. source : SoulSilver FR officiel
#. patch FR actuel : Force COSMIQUE
#: src/data/moves_info.h:8677
msgid "COSMIC POWER"
msgstr "Force Cosmik"

#. source : patch FR actuel
#: src/data/moves_info.h:8678
msgid "Raises Defense and Sp. Def\\nwith a mystic power."
msgstr "Pouvoir mystique qui monte\\nla Défense et la Déf. Spé."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8703
msgid "WATER SPOUT"
msgstr "Giclédo"

#. source : patch FR actuel
#: src/data/moves_info.h:8704
msgid "Inflicts more damage if the\\nuser's HP is high."
msgstr "Inflige plus de dégâts si le\\nlanceur a beaucoup de PV."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8725
msgid "SIGNAL BEAM"
msgstr "Rayon Signal"

#. source : patch FR actuel
#: src/data/moves_info.h:8726
msgid "A strange beam attack that\\nmay confuse the foe."
msgstr "Un étrange rayon qui peut\\nrendre l’ennemi confus."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8751
msgid "SHADOW PUNCH"
msgstr "Poing Ombre"

#. source : patch FR actuel
#: src/data/moves_info.h:8752
msgid "An unavoidable punch that\\nis thrown from shadows."
msgstr "Un coup de poing inévitable\\nsortant de l’ombre."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8775
msgid "EXTRASENSORY"
msgstr "Extrasenseur"

#. source : patch FR actuel
#: src/data/moves_info.h:8776
msgid "Attacks with a peculiar\\npower. May cause flinching."
msgstr "Pouvoir singulier qui peut\\napeurer l’ennemi."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8802
msgid "SKY UPPERCUT"
msgstr "Stratopercut"

#. source : patch FR actuel
#: src/data/moves_info.h:8803
msgid "An uppercut thrown as if\\nleaping into the sky."
msgstr "Un uppercut porté en\\ndirection du ciel."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8827
msgid "SAND TOMB"
msgstr "Tourbi-Sable"

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8853
msgid "SHEER COLD"
msgstr "Glaciation"

#. source : patch FR actuel
#: src/data/moves_info.h:8854
msgid "A chilling attack that\\ncauses fainting if it hits."
msgstr "Attaque glacée qui met K.O.\\nquand elle est réussie."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8877
msgid "MUDDY WATER"
msgstr "Ocroupi"

#. source : patch FR actuel
#: src/data/moves_info.h:8878
msgid "Attacks with muddy water.\\nMay lower accuracy."
msgstr "Attaque d’eau croupie.\\nPeut baisser la précision."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8904
msgid "BULLET SEED"
msgstr "Balle Graine"

#. source : patch FR actuel
#: src/data/moves_info.h:8905
msgid "Shoots 2 to 5 seeds in a row\\nto strike the foe."
msgstr "Mitraille l’ennemi avec 2 à\\n5 graines à la suite."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8927
msgid "AERIAL ACE"
msgstr "Aéropique"

#. source : patch FR actuel
#: src/data/moves_info.h:8928
msgid "An extremely speedy and\\nunavoidable attack."
msgstr "Attaque extrêmement\\nrapide et inévitable."

#. source : SoulSilver FR officiel
#. patch FR actuel : STALACTITE
#: src/data/moves_info.h:8951
msgid "ICICLE SPEAR"
msgstr "Stalagtite"

#. source : patch FR actuel
#: src/data/moves_info.h:8952
msgid "Attacks the foe by firing\\n2 to 5 icicles in a row."
msgstr "Mitraille l’ennemi avec 2 à\\n5 glaçons à la suite."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8973
msgid "IRON DEFENSE"
msgstr "Mur de Fer"

#. source : patch FR actuel
#: src/data/moves_info.h:8974
msgid "Hardens the body's surface\\nto sharply raise Defense."
msgstr "Endurcit le corps pour\\nbooster la Défense."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:8999
msgid "BLOCK"
msgstr "Barrage"

#. source : patch FR actuel
#: src/data/moves_info.h:9000
msgid "Blocks the foe's way and\\nprevents escape."
msgstr "Bloque le chemin de l’ennemi\\npour l’empêcher de fuir."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:9024
msgid "HOWL"
msgstr "Grondement"

#. source : patch FR actuel
#: src/data/moves_info.h:9025
msgid "Howls to raise the spirit\\nand boosts Attack."
msgstr "Grogne pour se rassurer\\net booster l’Attaque."

#. source : SoulSilver FR officiel
#. patch FR actuel : DRACO-GRIFFE
#: src/data/moves_info.h:9051
msgid "DRAGON CLAW"
msgstr "Dracogriffe"

#. source : patch FR actuel
#: src/data/moves_info.h:9052
msgid "Slashes the foe with sharp\\nclaws."
msgstr "Tranche l’ennemi avec\\ndes griffes acérées."

#. source : SoulSilver FR officiel
#. patch FR actuel : VEGE-ATTAQUE
#: src/data/moves_info.h:9074
msgid "FRENZY PLANT"
msgstr "Végé-Attak"

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:9101
msgid "BULK UP"
msgstr "Gonflette"

#. source : patch FR actuel
#: src/data/moves_info.h:9102
msgid "Bulks up the body to boost\\nboth Attack and Defense."
msgstr "Se gonfle pour booster\\nl’Attaque et la Défense."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:9127
msgid "BOUNCE"
msgstr "Rebond"

#. source : patch FR actuel
#: src/data/moves_info.h:9128
msgid "Bounces up, then down the\\nnext turn. May paralyze."
msgstr "Saute et tombe le tour\\nsuivant. Peut paralyser."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:9159
msgid "MUD SHOT"
msgstr "Tir de Boue"

#. source : patch FR actuel
#: src/data/moves_info.h:9160
msgid "Hurls mud at the foe and\\nreduces Speed."
msgstr "Envoie de la boue à l’ennemi\\npour réduire sa Vitesse."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:9184
msgid "POISON TAIL"
msgstr "Queue-Poison"

#. source : patch FR actuel
#: src/data/moves_info.h:9185
msgid "Has a high critical-hit\\nratio. May also poison."
msgstr "Haut taux de critiques.\\nPeut aussi empoisonner."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:9212
msgid "COVET"
msgstr "Implore"

#. source : patch FR actuel
#: src/data/moves_info.h:9213
msgid "Cutely begs to obtain an\\nitem held by the foe."
msgstr "Demande gentiment un objet\\ndétenu par l’ennemi."

#. source : SoulSilver FR officiel
#: src/data/moves_info.h:9239
msgid "VOLT TACKLE"
msgstr "Electacle"

#. source : patch FR actuel
#: src/data/moves_info.h:9241
