#. source : patch FR actuel
#: src/data/pokemon/species_info/gen_9_families.h:7071
msgid "CHI-YU"
msgstr "YUYU"

#. source : patch FR actuel
#: src/data/pokemon/species_info/gen_9_families.h:7077
