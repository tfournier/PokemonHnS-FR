#. source : patch FR actuel
#: src/data/pokemon/species_info/gen_9_families.h:6937
msgid "CHIEN-PAO"
msgstr "BAOJIAN"

#. source : patch FR actuel
#: src/data/pokemon/species_info/gen_9_families.h:6943
msgid ""
"This Pokémon can control 100 tons\\nof fallen snow. It plays "
"around\\ninnocently by leaping in and out of\\navalanches it has caused."
msgstr ""
"Il peut contrôler 100 tonnes de\\nneige. Il s’amuse innocemment à\\nbondir "
"dans les avalanches qu’il\\na lui-même provoquées."

#. source : patch FR actuel
#: src/data/pokemon/species_info/gen_9_families.h:7004
msgid "TING-LU"
msgstr "DINGLU"

#. source : patch FR actuel
#: src/data/pokemon/species_info/gen_9_families.h:7010
