#. source : patch FR actuel
#: src/data/pokemon/species_info/gen_9_families.h:7140
msgid "ROARING MOON"
msgstr "RUGIT-LUNE"

#. source : patch FR actuel
#: src/data/pokemon/species_info/gen_9_families.h:7146
msgid ""
"According to an article in a\\ndubious magazine, this Pokémon has "
"some\\nconnection to Mega Evolution that\\noccurs in Hoenn."
msgstr ""
"D’après un article d’un magazine\\ndouteux, ce Pokémon aurait un lien\\navec"
" la Méga-Évolution qui se\\nproduit à Hoenn."

#. source : patch FR actuel
#: src/data/pokemon/species_info/gen_9_families.h:7208
msgid "IRON VALIANT"
msgstr "GARDE-DE-FER"

#. source : patch FR actuel
#: src/data/pokemon/species_info/gen_9_families.h:7214
msgid ""
"It has some similarities to a mad\\nscientist's invention covered in "
"a\\nparanormal magazine."
msgstr ""
"Il ressemble à l’invention d’un\\nsavant fou présentée dans un\\nmagazine de"
" paranormal."

#. source : traduction manuelle (style SoulSilver)
#: src/data/pokemon/species_info/gen_9_families.h:7273
msgid "KORAIDON"
msgstr "KORAIDON"

#. source : patch FR actuel
#: src/data/pokemon/species_info/gen_9_families.h:7279
