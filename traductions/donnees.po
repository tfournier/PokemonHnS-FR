#. source : patch FR actuel
#: src/data/contest_moves.h:6
msgid "Quite the appealing move."
msgstr "Une capacité très attrayante."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:8
msgid "A highly appealing move."
msgstr "Une démonstration qui\\nplaît énormément."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:17
msgid "After this move, the user is\\nmore easily startled."
msgstr "Le Pokémon est facilement\\neffrayé après cette démo."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:25
msgid "Makes a great appeal, but\\nallows no more to the end."
msgstr "Plaît énormément, mais ne\\npermet plus aucune démo."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:33
msgid "Can be repeatedly used\\nwithout boring the JUDGE."
msgstr "Peut être utilisé plusieurs\\nfois sans ennuyer le JUGE."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:41
msgid "Can avoid being startled\\nby others once."
msgstr "Peut éviter une fois d’être\\neffrayé par les autres."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:49
msgid "Can avoid being startled\\nby others."
msgstr "Peut éviter d’être effrayé\\npar les autres."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:57
msgid "Can avoid being startled\\nby others a little."
msgstr "Peut un peu éviter d’être\\neffrayé par les autres."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:65
msgid "After this move, the user is\\nless likely to be startled."
msgstr "Le Pokémon a moins de\\nchances d’être effrayé."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:73
msgid "Slightly startles the\\nPOKéMON in front."
msgstr "Effraie légèrement le\\nPokémon précédent."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:81
msgid "Slightly startles those\\nthat have made appeals."
msgstr "Effraie légèrement ceux\\nqui ont déjà fait leur démo."

#. source : patch FR actuel
#: src/data/contest_moves.h:90
msgid "Startles the last Pokémon\\nto act before the user."
msgstr "Effraie le dernier Pokémon\\npassé avant le lanceur."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:92 src/data/contest_moves.h:129
msgid "Startles the POKéMON that\\nappealed before the user."
msgstr "Effraie le Pokémon ayant\\nfait sa démo avant."

#. source : patch FR actuel
#: src/data/contest_moves.h:102
msgid "Startles all of the Pokémon\\nto act before the user."
msgstr "Effraie tous les Pokémon\\nqui sont passés avant."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:104 src/data/contest_moves.h:137
msgid "Startles all POKéMON that\\nhave done their appeals."
msgstr "Effraie les Pokémon ayant\\nfait leur démonstration."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:113
msgid "Badly startles the\\nPOKéMON in front."
msgstr "Effraie beaucoup le\\nPokémon précédent."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:121
msgid "Badly startles those that\\nhave made appeals."
msgstr "Effraie beaucoup ceux\\nqui ont déjà fait leur démo."

#. source : patch FR actuel
#: src/data/contest_moves.h:146
msgid "Makes audience expect\\nlittle of other contestants."
msgstr "Le public n’attend plus\\ngrand-chose des autres."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:148
msgid "Shifts the JUDGE's\\nattention from others."
msgstr "Détourne l’attention du\\nJUGE des autres Pokémon."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:157
msgid "Startles the POKéMON that\\nhas the JUDGE's attention."
msgstr "Effraie le Pokémon qui\\na l’attention du JUGE."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:165
msgid "Jams the others, and misses\\none turn of appeals."
msgstr "Bloque les autres, mais\\nperd un tour de démo."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:173
msgid "Startles POKéMON that\\nmade a same-type appeal."
msgstr "Effraie ceux ayant exécuté\\nune démo du même type."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:181
msgid "Badly startles POKéMON\\nthat made COOL appeals."
msgstr "Effraie beaucoup ceux qui\\nont fait une démo SG-FD."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:189
msgid "Badly startles POKéMON\\nthat made BEAUTY appeals."
msgstr "Effraie beaucoup ceux qui\\nont fait une démo BEAUTE."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:197
msgid "Badly startles POKéMON\\nthat made CUTE appeals."
msgstr "Effraie beaucoup ceux qui\\nont fait une démo GRACE."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:205
msgid "Badly startles POKéMON\\nthat made SMART appeals."
msgstr "Effraie beaucoup ceux qui\\nont fait une démo INTEL."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:213
msgid "Badly startles POKéMON\\nthat made TOUGH appeals."
msgstr "Effraie beaucoup ceux qui\\nont fait une démo ROBUS."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:221
msgid "Makes one POKéMON after\\nthe user nervous."
msgstr "Rend nerveux le Pokémon\\nsuivant."

#. source : patch FR actuel
#: src/data/contest_moves.h:230
msgid "Makes the remaining\\nPokémon nervous."
msgstr "Rend nerveux les\\nPokémon suivants."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:232
msgid "Makes all POKéMON after\\nthe user nervous."
msgstr "Rend nerveux tous les\\nPokémon suivants."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:241
msgid "Worsens the condition of\\nthose that made appeals."
msgstr "Diminue la condition de\\nceux qui ont fait une démo."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:249
msgid "Badly startles POKéMON in\\ngood condition."
msgstr "Effraie beaucoup ceux qui\\nsont en bonne condition."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:257
msgid "The appeal works great if\\nperformed first."
msgstr "Cette démo plaît beaucoup\\nsi on l’exécute en premier."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:265
msgid "The appeal works great if\\nperformed last."
msgstr "Cette démo plaît beaucoup\\nsi on l’exécute en dernier."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:273
msgid "Makes the appeal as good\\nas those before it."
msgstr "Rend la démo aussi réussie\\nque les précédentes."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:281
msgid "Makes the appeal as good\\nas the one before it."
msgstr "Rend la démo aussi réussie\\nque la précédente."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:289
msgid "The appeal works better\\nthe later it is performed."
msgstr "Plus cette démo est lancée\\ntard, plus elle est réussie."

#. source : patch FR actuel
#: src/data/contest_moves.h:298
msgid "Effectiveness varies\\ndepending on when it is used."
msgstr "Son efficacité varie selon\\nle moment où on l’utilise."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:300
msgid "The appeal's quality varies\\ndepending on its timing."
msgstr "La qualité de la démo\\ndépend de son timing."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:309
msgid "Works well if it's the same\\ntype as the one before."
msgstr "Démo réussie si du même\\ntype que la précédente."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:317
msgid "Works well if different in\\ntype than the one before."
msgstr "Démo réussie si de type\\ndifférent de la précédente."

#. source : patch FR actuel
#: src/data/contest_moves.h:326
msgid "Affected by how well the\\nprevious Pokémon's move went."
msgstr "Dépend du succès de la capacité\\ndu Pokémon précédent."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:328
msgid "Affected by how well the\\nappeal in front goes."
msgstr "Dépend de la façon dont la\\ndémo précédente se passe."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:337
msgid "Ups the user's condition.\\nHelps prevent nervousness."
msgstr "Monte la condition.\\nEmpêche d’être nerveux."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:345
msgid "The appeal works well if the\\nuser's condition is good."
msgstr "Démo réussie si la condi-\\ntion du Pokémon est bonne."

#. source : patch FR actuel
#: src/data/contest_moves.h:354
msgid "Causes the user to move\\nearlier on the next turn."
msgstr "Permet au lanceur d’agir\\nplus tôt au tour suivant."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:356
msgid "The next appeal can be\\nmade earlier next turn."
msgstr "Prochaine démo exécutée\\nplus tôt au tour suivant."

#. source : patch FR actuel
#: src/data/contest_moves.h:366
msgid "Causes the user to move\\nlater on the next turn."
msgstr "Permet au lanceur d’agir\\nplus tard au tour suivant."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:368
msgid "The next appeal can be\\nmade later next turn."
msgstr "Prochaine démo exécutée\\nplus tard au tour suivant."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:377
msgid "Makes the next turn's order\\nmore easily scrambled."
msgstr "Facilite le changement des\\npassages du prochain tour."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:385
msgid "Scrambles the order of\\nappeals on the next turn."
msgstr "Mélange l’ordre de passage\\ndes démos du prochain tour."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:393
msgid "An appeal that excites the\\naudience in any CONTEST."
msgstr "Une démo qui enthousiasme\\nle public de tout CONCOURS."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:401
msgid "Badly startles all POKéMON\\nthat made good appeals."
msgstr "Effraie beaucoup tous les\\nPokémon qui ont plu."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:409
msgid "The appeal works best the\\nmore the crowd is excited."
msgstr "La démo est plus réussie si\\nle public est enthousiaste."

#. source : Émeraude FR officiel
#: src/data/contest_moves.h:417
msgid "Temporarily stops the\\ncrowd from growing excited."
msgstr "Empêche provisoirement le\\npublic d’être enthousiaste."

