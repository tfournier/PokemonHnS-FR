msgstr "CHONGJIAN"

#. source : patch FR actuel
#: src/data/pokemon/species_info/gen_9_families.h:6873
#: src/data/pokemon/species_info/gen_9_families.h:6940
#: src/data/pokemon/species_info/gen_9_families.h:7007
#: src/data/pokemon/species_info/gen_9_families.h:7074
msgid "Ruinous"
msgstr "Fléau"

#. source : patch FR actuel
#: src/data/pokemon/species_info/gen_9_families.h:6876
