#. source : traduction manuelle (style SoulSilver)
#: src/data/pokemon/species_info/gen_9_families.h:7341
msgid "MIRAIDON"
msgstr "MIRAIDON"

#. source : patch FR actuel
#: src/data/pokemon/species_info/gen_9_families.h:7347
