#. source : Émeraude FR officiel
#: src/data/union_room.h:193
msgid "{STR_VAR_1}: What would you like to\\ndo now?"
msgstr "{STR_VAR_1}: Qu’est-ce que vous\\nvoulez faire maintenant?"

#. source : traduction nouvelle
#. lot : C1_restes
#. preuve : cf. entrées Émeraude FR voisines (« Veuillez choisir le Dresseur
#. avec\nqui faire l’échange. », « Transmission… »)
#: src/data/union_room.h:194
msgid "{STR_VAR_1}: Want to do anything else?"
msgstr "{STR_VAR_1}: On fait autre chose?"

#. source : Émeraude FR officiel
#: src/data/union_room.h:207
msgid "Somebody has contacted you.{PAUSE 60}"
msgstr "Quelqu’un vous contacte.{PAUSE 60}"

#. source : Émeraude FR officiel
#: src/data/union_room.h:208
msgid "{STR_VAR_1} has contacted you.{PAUSE 60}"
msgstr "{STR_VAR_1} essaie de vous contacter.{PAUSE 60}"

#. source : Émeraude FR officiel
#: src/data/union_room.h:215 src/data/union_room.h:462
msgid "Awaiting a response from\\nthe other TRAINER…"
msgstr "En attente d’une réponse de\\nl’autre Dresseur…"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EE358 -> FR 2F72EC (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : En attente d’une\nréponse de {STR_VAR_1}…
#: src/data/union_room.h:216
msgid "Awaiting a response from\\n{STR_VAR_1}…"
msgstr "En attente d’une réponse de\\n{STR_VAR_1}…"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EE380 -> FR 2F7314 (pointeur x1) ; table octets EN->FR (x1)
#. ancien (patch FR actuel) : L’autre Dresseur vous montre\nsa Carte
#. Dresseur.\pVoulez-vous montrer votre\nCarte Dresseur?
#: src/data/union_room.h:223
msgid ""
"The other TRAINER showed\\nyou their TRAINER CARD.\\pWould you like to show "
"your\\nTRAINER CARD?"
msgstr ""
"L’autre Dresseur vous montre\\nsa Carte DE Dresseur.\\pVoulez-vous montrer "
"votre\\nCarte DE Dresseur?"

#. source : Émeraude FR officiel
#: src/data/union_room.h:224
msgid ""
"The other TRAINER challenges you\\nto battle.\\pWill you accept the "
"battle\\nchallenge?"
msgstr "L’autre Dresseur veut se\\nbattre contre vous.\\pAccepter le combat?"

#. source : Émeraude FR officiel
#: src/data/union_room.h:225
msgid ""
"The other TRAINER invites you\\nto chat.\\pWill you accept the "
"chat\\ninvitation?"
msgstr "L’autre Dresseur vous invite\\nà discuter.\\pAccepter l’invitation?"

#. source : traduction nouvelle
#. lot : C2b_donnees
#. ancien (traduction manuelle (style SoulSilver)) : On vous propose
#. d’échanger votre\nPokémon N. {DYNAMIC 0} {DYNAMIC 1}\pcontre un\nN.
#. {DYNAMIC 2} {DYNAMIC 3}.\pAccepter cette offre d’échange?
#: src/data/union_room.h:226
msgid ""
"There is an offer to trade your\\nregistered Lv. {DYNAMIC 0} {DYNAMIC "
"1}\\pin exchange for a\\nLv. {DYNAMIC 2} {DYNAMIC 3}.\\pWill you accept this"
" trade\\noffer?"
msgstr ""
"On vous propose d’échanger votre\\nPokémon inscrit N. {DYNAMIC 0} {DYNAMIC "
"1}\\pcontre un\\nN. {DYNAMIC 2} {DYNAMIC 3}.\\pAccepter cette offre "
"d’échange?"

#. source : Émeraude FR officiel
#: src/data/union_room.h:227
msgid ""
"There is an offer to trade your\\nregistered EGG.\\lWill you accept this "
"trade offer?"
msgstr ""
"Il y a une offre d’échange pour\\nvotre Œuf enregistré.\\lAccepter l’offre "
"d’échange?"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EE544 -> FR 2F74AC (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : La connexion a été interrompue.
#: src/data/union_room.h:228
msgid "The chat has been dropped.\\p"
msgstr "La communication est abandonnée.\\p"

#. source : Émeraude FR officiel
#: src/data/union_room.h:229 src/data/union_room.h:230
msgid "You declined the offer.\\p"
msgstr "Vous déclinez l’offre.\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EE598 -> FR 2F7500 (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : La connexion a été interrompue.
#: src/data/union_room.h:231
msgid "The chat was ended.\\p"
msgstr "Le tchat est terminé.\\p"

#. source : Émeraude FR officiel
#: src/data/union_room.h:241
msgid "Oh, hey! We're in a chat right now.\\nWant to join us?"
msgstr "On est en plein dans un tchat.\\nTu nous rejoins?"

#. source : Émeraude FR officiel
#: src/data/union_room.h:242
msgid ""
"{STR_VAR_1}: Hey, {PLAYER}!\\nWe're having a chat right now.\\lWant to join "
"us?"
msgstr ""
"{STR_VAR_1}: Salut, {PLAYER}!\\nOn est en train de tchater.\\lTu veux nous "
"rejoindre?"

#. source : Émeraude FR officiel
#: src/data/union_room.h:243
msgid "Oh, hi! We're having a chat now.\\nWould you like to join us?"
msgstr "Bonjour! On est en plein tchat.\\nTu nous rejoins?"

#. source : Émeraude FR officiel
#: src/data/union_room.h:244
msgid ""
"{STR_VAR_1}: Oh, hi, {PLAYER}!\\nWe're having a chat now.\\lWould you like "
"to join us?"
msgstr ""
"{STR_VAR_1}: Oh, coucou, {PLAYER}!\\nNous sommes en train de tchater.\\lTu "
"te joins à nous?"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EE6C8 -> FR 2F762C (pointeur x3) ; table octets EN->FR (x3)
#. ancien (SoulSilver FR officiel) : ... ... Le Dresseur est occupé.
#: src/data/union_room.h:256
msgid "……\\nThe TRAINER appears to be busy…\\p"
msgstr "……\\nLe Dresseur est occupé…\\p"

#. source : Émeraude FR officiel
#: src/data/union_room.h:257
msgid "A battle, huh?\\nAll right, just give me some time."
msgstr "Un combat, hein?\\nTrès bien, juste un instant."

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EE720 -> FR 2F7678 (pointeur x1) ; table octets EN->FR (x1)
#. ancien (patch FR actuel) : Un tchat?\nBien sûr, attends un peu.
#: src/data/union_room.h:258 src/data/union_room.h:278
msgid "You want to chat, huh?\\nSure, just wait a little."
msgstr "Un tchat?\\nPas de problème, juste un instant."

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EE754 -> FR 2F76A8 (pointeur x1) ; table octets EN->FR (x1)
#. ancien (patch FR actuel) : Pareil pour moi!\nVoilà ma Carte Dresseur.
#: src/data/union_room.h:259
msgid "Sure thing! As my “Greetings,”\\nhere's my TRAINER CARD."
msgstr "Pareil pour moi!\\nVoilà ma Carte DE Dresseur."

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EE78C -> FR 2F76D8 (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : Un combat, hein? Très bien,\njuste un
#. instant.
#: src/data/union_room.h:260
msgid "A battle? Of course, but I need\\ntime to get ready."
msgstr "Un combat? Bien sûr!\\nJuste un instant, je me prépare."

#. source : Émeraude FR officiel
#: src/data/union_room.h:261
msgid "Did you want to chat?\\nOkay, but please wait a moment."
msgstr "Un tchat?\\nPas de problème, juste un instant."

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EE7F8 -> FR 2F7740 (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : Pour me présenter, je vais te montrer\nma
#. Carte de Dresseur.
#: src/data/union_room.h:262
msgid "As my introduction, I'll show you\\nmy TRAINER CARD."
msgstr "On se présente?\\nVoilà ma Carte DE Dresseur."

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EE880 -> FR 2F77C0 (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : Merci d’avoir patienté!
#. Allez,\ncommençons le combat!{PAUSE 60}
#: src/data/union_room.h:279
msgid "Thanks for waiting!\\nLet's get our battle started!{PAUSE 60}"
msgstr "Merci d’avoir patienté!\\nAllez, commençons le combat!{PAUSE 60}"

#. source : Émeraude FR officiel
#: src/data/union_room.h:280
msgid "All right!\\nLet's chat!{PAUSE 60}"
msgstr "Parfait!\\nCommençons le tchat.{PAUSE 60}"

#. source : Émeraude FR officiel
#: src/data/union_room.h:281
msgid "Sorry I made you wait!\\nLet's get started!{PAUSE 60}"
msgstr "Tu n’as pas trop attendu?\\nCommençons!{PAUSE 60}"

#. source : Émeraude FR officiel
#: src/data/union_room.h:282
msgid "Sorry I made you wait!\\nLet's chat.{PAUSE 60}"
msgstr "Tu n’as pas trop attendu?\\nCommençons le tchat.{PAUSE 60}"

#. source : Émeraude FR officiel
#: src/data/union_room.h:283
msgid "The trade will be started.{PAUSE 60}"
msgstr "L’échange va commencer.{PAUSE 60}"

#. source : Émeraude FR officiel
#: src/data/union_room.h:284
msgid "The battle will be started.{PAUSE 60}"
msgstr "Le combat va commencer.{PAUSE 60}"

#. source : Émeraude FR officiel
#: src/data/union_room.h:285
msgid "Entering the chat…{PAUSE 60}"
msgstr "Début du tchat…{PAUSE 60}"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EE9B4 -> FR 2F78F8 (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : Dommage! Mes Pokémon ne sont
#. pas\nvraiment en forme.\pJe t’écraserai une prochaine fois.
#: src/data/union_room.h:311
msgid ""
"Sorry! My POKéMON don't seem to\\nbe feeling too well right now.\\lLet me "
"battle you another time.\\p"
msgstr ""
"Dommage! Mes Pokémon ne sont\\npas vraiment en forme.\\lJe t’écraserai une "
"prochaine fois.\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EEA14 -> FR 2F7950 (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : Je suis désolée, mais mes Pokémon ne\nse
#. sentent pas bien.\pBattons-nous une prochaine fois!
#: src/data/union_room.h:312
msgid ""
"I'm terribly sorry, but my POKéMON\\naren't feeling well…\\pLet's battle "
"another time.\\p"
msgstr ""
"Je suis désolée, mais mes Pokémon\\nne se sentent pas bien…\\pBattons-nous "
"une prochaine fois!\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EEA70 -> FR 2F79B4 (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : Hein? Ma Carte de Dresseur... Je
#. l’ai\nmise où?\pTant pis, la prochaine fois alors!
#: src/data/union_room.h:319
msgid ""
"Huh? My TRAINER CARD…\\nWhere'd it go now?\\lSorry! I'll show you another "
"time!\\p"
msgstr ""
"Hein? Ma Carte DE Dresseur…\\nJ’l’ai mise où?\\lTant pis, la prochaine fois "
"alors!\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EEAC0 -> FR 2F7A04 (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : Oh! Mais où est passée ma Carte
#. de\nDresseur?\pDésolée! La prochaine fois alors!
#: src/data/union_room.h:320
msgid "Oh? Now where did I put my\\nTRAINER CARD?…\\lSorry! I'll show you later!\\p"
msgstr ""
"Oh! Mais où est passée ma\\nCarte DE Dresseur?\\lDésolée! La prochaine fois "
"alors!\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EEB10 -> FR 2F7A5C (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : Si tu as besoin de moi, fais-moi signe!
#: src/data/union_room.h:327
msgid "If you want to do something with\\nme, just give me a shout!\\p"
msgstr "Si tu as besoin de moi,\\nfais-moi signe!\\p"

#. source : Émeraude FR officiel
#: src/data/union_room.h:328
msgid "If you want to do something with\\nme, don't be shy.\\p"
msgstr "Si tu veux faire un truc, n’hésite\\npas à demander.\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EEB88 -> FR 2F7AC4 (pointeur x2) ; table octets EN->FR (x2)
#. ancien (SoulSilver FR officiel (adapté)) : Oups! Dommage, j’ai autre\nchose
#. à faire.\lUne autre fois, OK?\p
#: src/data/union_room.h:335
msgid "Whoops! Sorry, but I have to do\\nsomething else.\\lAnother time, okay?\\p"
msgstr "Oups! Dommage, j’ai autre \\nchose à faire.\\lUne autre fois, OK?\\p"

#. source : Émeraude FR officiel (contexte de script)
#: src/data/union_room.h:336
msgid "If you want to battle, you need\\ntwo POKéMON that are below\\lLv. 30.\\p"
msgstr ""
"Si tu veux te battre, il te faut deux\\nPokémon de niveau inférieur à 30.\\p"

#. source : Émeraude FR officiel
#: src/data/union_room.h:337
msgid "For a battle, you need two\\nPOKéMON that are below Lv. 30.\\p"
msgstr "Pour combattre, il te faut deux\\nPokémon de niveau inférieur\\là 30.\\p"

#. source : Émeraude FR officiel
#. SoulSilver (approché) : Bon, OK. A la prochaine alors.
#: src/data/union_room.h:339
msgid "Oh, all right.\\nCome see me anytime, okay?\\p"
msgstr "Bon, OK.\\nA la prochaine alors.\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EEC7C -> FR 2F7BB4 (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : Oh... A la prochaine alors.
#: src/data/union_room.h:340
msgid "Oh…\\nPlease come by anytime.\\p"
msgstr "Oh…\\nA la prochaine alors.\\p"

#. source : Émeraude FR officiel
#: src/data/union_room.h:348
msgid "Oh, sorry!\\nI just can't right this instant.\\lLet's chat another time.\\p"
msgstr "Bon…\\nC’est pas vraiment le moment.\\lOn tchatera une prochaine fois.\\p"

#. source : Émeraude FR officiel
#: src/data/union_room.h:349
msgid ""
"Oh, I'm sorry.\\nI have too much to do right now.\\lLet's chat some other "
"time.\\p"
msgstr ""
"Vraiment navrée.\\nJ’ai plein de choses à faire.\\lCe sera pour la prochaine"
" fois.\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EED44 -> FR 2F7C74 (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : Waouh! T’en as dans le ventre!
#: src/data/union_room.h:357
msgid "Whoa!\\nI can tell you're pretty tough!\\p"
msgstr "Waouh!\\nT’en as dans le ventre!\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EED6C -> FR 2F7C94 (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : T’as utilisé cette capacité?
#. Bonne\nstratégie!
#: src/data/union_room.h:358
msgid "You used that move?\\nThat's good strategy!\\p"
msgstr "T’as utilisé cette capacité?\\nBonne stratégie!\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EED98 -> FR 2F7CC4 (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : Voilà! C’est comme ça qu’il faut faire!
#: src/data/union_room.h:359
msgid "Way to go!\\nThat was an eye-opener!\\p"
msgstr "Voilà!\\nC’est comme ça qu’y faut faire!\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EEDBC -> FR 2F7CEC (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : Oh! C’est pas le bon moment
#. pour\nutiliser ce Pokémon!
#: src/data/union_room.h:360
msgid "Oh! How could you use that\\nPOKéMON in that situation?\\p"
msgstr "Oh! C’est pas le bon moment\\npour utiliser ce Pokémon!\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EEDF4 -> FR 2F7D24 (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : Ce Pokémon... Il est super bien\ndressé!
#: src/data/union_room.h:361
msgid "That POKéMON…\\nIt's been raised really well!\\p"
msgstr "Ce Pokémon…\\nIl est super bien dressé!\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EEE24 -> FR 2F7D4C (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : C’est ça! C’est la bonne capacité!
#: src/data/union_room.h:362
msgid "That's it!\\nThis is the right move now!\\p"
msgstr "C’est ça!\\nC’est la bonne capacité!\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EEE4C -> FR 2F7D70 (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : Incroyable! Tu peux te battre comme\nça?
#: src/data/union_room.h:363
msgid "That's awesome!\\nYou can battle that way?\\p"
msgstr "Incroyable!\\nTu peux te battre comme ça?\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EEE78 -> FR 2F7D9C (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : Tu sais vraiment changer de Pokémon\nau
#. bon moment!
#: src/data/union_room.h:364
msgid "You have exquisite timing for\\nswitching POKéMON!\\p"
msgstr "Tu sais vraiment changer de\\nPokémon au bon moment!\\p"

#. source : Émeraude FR officiel
#: src/data/union_room.h:381
msgid "Oh, I see!\\nThis is educational!\\p"
msgstr "Oh, je vois!\\nC’était plutôt instructif!\\p"

#. source : Émeraude FR officiel
#: src/data/union_room.h:382
msgid "Don't say anything funny anymore!\\nI'm sore from laughing!\\p"
msgstr "Ne dis plus rien! J’ai des crampes\\nà force de rire!\\p"

#. source : Émeraude FR officiel
#: src/data/union_room.h:383
msgid "Oh?\\nSomething like that happened.\\p"
msgstr "Oh?\\nC’est vraiment arrivé?\\p"

#. source : Émeraude FR officiel
#: src/data/union_room.h:384
msgid "Hmhm… What?\\nSo is this what you're saying?\\p"
msgstr "Hm… Quoi?\\nSi tu le dis…\\p"

#. source : Émeraude FR officiel
#: src/data/union_room.h:385
msgid "Is that right?\\nI didn't know that.\\p"
msgstr "Vraiment?\\nJe savais pas.\\p"

#. source : Émeraude FR officiel
#: src/data/union_room.h:386
msgid "Ahaha!\\nWhat is that about?\\p"
msgstr "Ahaha!\\nVraiment?\\p"

#. source : Émeraude FR officiel
#: src/data/union_room.h:387
msgid "Yes, that's exactly it!\\nThat's what I meant.\\p"
msgstr "Oui, c’est ça!\\nC’est ce que je voulais dire.\\p"

#. source : Émeraude FR officiel
#: src/data/union_room.h:388
msgid "In other words…\\nYes! That's right!\\p"
msgstr "En d’autres termes…\\nOui, c’est ça!\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EF030 -> FR 2F7F30 (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel (adapté)) : Je montre toujours ma Carte
#. de\nDresseur pour me présenter.\p
#: src/data/union_room.h:405
msgid "I'm just showing my TRAINER CARD\\nas my way of greeting.\\p"
msgstr "Je montre toujours ma Carte DE\\nDresseur pour me présenter.\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EF06C -> FR 2F7F6C (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : J’espère qu’on apprendra à se\nconnaître!
#: src/data/union_room.h:406
msgid "I hope I get to know you better!\\p"
msgstr "J’espère qu’on apprendra à se\\nconnaître!\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EF090 -> FR 2F7F98 (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : On se montre notre Carte de
#. Dresseur\npour faire connaissance.
#: src/data/union_room.h:407
msgid "We're showing each other our\\nTRAINER CARDS to get acquainted.\\p"
msgstr "On se présente notre Carte DE\\nDresseur pour faire connaissance.\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EF0D0 -> FR 2F7FDC (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : On va bien s’entendre. Je le sens!
#: src/data/union_room.h:408
msgid "Glad to meet you.\\nPlease don't be a stranger!\\p"
msgstr "On va bien s’entendre.\\nJe le sens!\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EF110 -> FR 2F8010 (pointeur x1) ; table octets EN->FR (x1)
#. ancien (patch FR actuel) : Cool!\nJe le voulais vraiment ce Pokémon!\p
#: src/data/union_room.h:421
msgid "Yeahah!\\nI really wanted this POKéMON!\\p"
msgstr "Cool! \\nJe le voulais vraiment ce Pokémon!\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EF138 -> FR 2F803C (pointeur x1) ; table octets EN->FR (x1)
#. ancien (patch FR actuel) : Finalement, j’obtiens ce\nPOKéMON grâce à un
#. échange.\p
#: src/data/union_room.h:422
msgid "Finally, a trade got me that\\nPOKéMON I'd wanted a long time.\\p"
msgstr "Finalement, j’obtiens ce\\nPokémon grâce à un échange.\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EF178 -> FR 2F8074 (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : Je suis en train de faire un échange.
#: src/data/union_room.h:423
msgid "I'm trading POKéMON right now.\\p"
msgstr "Je suis en train de faire\\nun échange.\\p"

#. source : Émeraude FR officiel
#. lot : A_emeraude
#. preuve : US 2EF198 -> FR 2F809C (pointeur x1) ; table octets EN->FR (x1)
#. ancien (SoulSilver FR officiel) : C’est le Pokémon que je
#. voulais\ntellement!
#: src/data/union_room.h:424
msgid "I finally got that POKéMON I\\nwanted in a trade!\\p"
msgstr "C’est le Pokémon que je voulais\\ntellement!\\p"

