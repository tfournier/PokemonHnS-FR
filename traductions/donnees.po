#: src/data/help_window.h:33
msgid "WARNING: COMPATIBILITY"
msgstr "ATTENTION: COMPATIBILITE"

#. source : traduction nouvelle
#. lot : C2b_donnees
#. ancien (patch FR actuel) : Un échange mal fait peut
#. endommager\ndéfinitivement votre sauvegarde.\nNe vous connectez avec un
#. joueur que si:\nVous jouez tous deux à Heart & Soul.\nVous avez la même
#. version du jeu.\nVous avez les mêmes réglages de défi.\nVous n’utilisez
#. Aucun réglage aléatoire.
#: src/data/help_window.h:34
msgid ""
"Attempting to link incorrectly may result\\nin permanent damage to your save"
" file.\\nOnly link with another player if:\\nYou are both playing Heart & "
"Soul.\\nYou are both on the same version.\\nYou both have the same challenge"
" settings.\\nYou are NOT using any randomizer settings."
msgstr ""
"Une connexion mal faite peut endommager\\ndéfinitivement votre "
"sauvegarde.\\nNe vous connectez avec un joueur que si:\\nVous jouez tous "
"deux à Heart & Soul.\\nVous avez la même version du jeu.\\nVous avez les "
"mêmes réglages de défi.\\nVous n’utilisez AUCUN réglage aléatoire."

#. source : patch FR actuel
#: src/data/help_window.h:48
msgid "OPTIONAL BONUS CONTENT: TELEPORTER"
msgstr "CONTENU BONUS FACULTATIF: TELEPORTEUR"

#. source : traduction nouvelle
#. lot : C2b_donnees
#. ancien (patch FR actuel) : Le TELEPORTEUR peut changer DEFINITIVEMENT\ndes
#. Pokémon en leur forme de GALAR.\nLes formes de GALAR ne sont PAS
#. requises\npour l’histoire ni pour compléter\nle Pokédex NATIONAL.\n
