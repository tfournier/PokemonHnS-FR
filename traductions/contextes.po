msgctxt "data/maps/Route104/scripts.inc"
msgid ""
"MAY: Oh, what's the matter?\\pHaven't you caught or raised your\\nPOKéMON "
"very much?\\pThat's not very good for a TRAINER!"
msgstr ""
"FLORA: Quoi? Tu n’avais pas dressé\\ntes Pokémon?\\pCe n’est pas une très "
"bonne\\nperformance pour un Dresseur…"

#. source : Émeraude FR officiel
#. lot : C1_restes
#. preuve : US 1EE04D -> FR 1EEDCF (pointeur x2) ; table octets EN->FR (x2)
#: data/maps/Route104/scripts.inc:0
msgctxt "data/maps/Route104/scripts.inc"
msgid "BRENDAN: What's the matter? Don't have\\nany confidence in your POKéMON?"
msgstr "BRICE: Quel est le problème? Tu n’as\\npas confiance en tes Pokémon?"

#. source : Émeraude FR officiel
#. lot : C1_restes
#. preuve : US 1EE094 -> FR 1EEE12 (pointeur x1) ; table octets EN->FR (x1)
#: data/maps/Route104/scripts.inc:0
msgctxt "data/maps/Route104/scripts.inc"
msgid "BRENDAN: What's up?\\nWant to have a battle with me?"
msgstr "BRICE: Ça roule?\\nTu veux te battre contre moi?"

#. source : Émeraude FR officiel
#. lot : C1_restes
#. preuve : US 1EE0C7 -> FR 1EEE41 (pointeur x1) ; table octets EN->FR (x1)
#: data/maps/Route104/scripts.inc:0
msgctxt "data/maps/Route104/scripts.inc"
msgid "BRENDAN: I know you just became\\na TRAINER, but I won't go easy!"
msgstr ""
"BRICE: Je sais que ça ne fait pas\\nlongtemps que tu es Dresseur,\\pmais "
"j’vais me battre sans retenir\\nmes coups!"

#. source : Émeraude FR officiel
#. lot : C1_restes
