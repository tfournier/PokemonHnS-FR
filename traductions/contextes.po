msgctxt "data/text/braille.inc"
msgid "GO UP HERE."
msgstr "RENDS-TOI\\nDANS LES\\nPROFONDEURS'"

#. source : Émeraude FR officiel
#. lot : B_braille
#: data/text/braille.inc:0
