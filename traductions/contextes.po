msgid ","
msgstr ","

#. source : Émeraude FR officiel
#. lot : B_braille
#: data/text/braille.inc:0
msgctxt "data/text/braille.inc"
msgid "DIG HERE."
msgstr "RETOURNE\\nLA TERRE'"

#. source : Émeraude FR officiel
#. lot : B_braille
#: data/text/braille.inc:0
msgctxt "data/text/braille.inc"
msgid "FIRST COMES\\nWAILORD.\\nLAST COMES\\nRELICANTH."
msgstr "COMMENCE PAR\\nWAILORD\\nET FINIS AVEC\\nRELICANTH'"

#. source : Émeraude FR officiel
#. lot : B_braille
#: data/text/braille.inc:0
msgctxt "data/text/braille.inc"
msgid "IN THIS\\nCAVE WE\\nHAVE\\nLIVED."
msgstr "DANS CETTE\\nCAVERNE VIVAIT\\nAUTREFOIS\\nNOTRE PEUPLE'"

#. source : Émeraude FR officiel
#. lot : B_braille
#: data/text/braille.inc:0
msgctxt "data/text/braille.inc"
msgid "WE OWE ALL\\nTO THE\\nPOKEMON."
msgstr "NOUS DEVONS\\nTOUT AUX\\nPOKEMON'"

#. source : Émeraude FR officiel
#. lot : B_braille
#: data/text/braille.inc:0
msgctxt "data/text/braille.inc"
msgid "BUT, WE\\nSEALED THE\\nPOKEMON\\nAWAY."
msgstr "MAIS NOUS LES\\nAVONS RETENUS\\nLOIN DE NOUS'"

#. source : Émeraude FR officiel
#. lot : B_braille
#: data/text/braille.inc:0
msgctxt "data/text/braille.inc"
msgid "WE FEARED IT."
msgstr "JADIS, NOUS\\nCRAIGNIONS LES\\nPOKEMON'"

#. source : Émeraude FR officiel
#. lot : B_braille
#: data/text/braille.inc:0
msgctxt "data/text/braille.inc"
msgid "THOSE WITH\\nCOURAGE,\\nTHOSE WITH\\nHOPE."
msgstr "DEMONTRE TON\\nCOURAGE'"

#. source : Émeraude FR officiel
#. lot : B_braille
#: data/text/braille.inc:0
msgctxt "data/text/braille.inc"
msgid "OPEN A DOOR.\\nAN ETERNAL\\nPOKEMON\\nWAITS."
msgstr "OUVRE LA PORTE\\nET LIBERE UN\\nPOKEMON\\nETERNEL'"

#. source : Émeraude FR officiel
#. lot : B_braille
#: data/text/braille.inc:0
msgctxt "data/text/braille.inc"
msgid "LEFT, LEFT,\\nDOWN, DOWN.\\nTHEN, USE\\nROCK SMASH."
msgstr "GAUCHE,\\nGAUCHE, BAS,\\nBAS ET UTILISE\\nECLATE-ROC'"

#. source : Émeraude FR officiel
#. lot : B_braille
#: data/text/braille.inc:0
msgctxt "data/text/braille.inc"
msgid "STAY CLOSE\\nTO THE WALL.\\nRUN AROUND\\nONE LAP."
msgstr "RESTE PRES\\nDU MUR'\\nTOURNE AUTOUR\\nUNE FOIS'"

#. source : Émeraude FR officiel
#. lot : B_braille
#: data/text/braille.inc:0
msgctxt "data/text/braille.inc"
msgid "THOSE WHO\\nINHERIT OUR\\nWILL, SHINE\\nIN THE MIDDLE."
