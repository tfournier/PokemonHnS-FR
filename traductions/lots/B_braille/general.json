  "source": "Émeraude FR officiel",
  "fichier": "data/text/braille.inc",
  "note": "inscription braille officielle (seul emploi)"
 },
 {
  "msgid": "LEFT, LEFT,\\nDOWN, DOWN.\\nTHEN, USE\\nROCK SMASH.",
