[
 {
  "msgid": "Who wouldn't?",
  "msgstr": "Évidemment!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonMansion_2F_Frlg/scripts.inc",
  "ligne": 37,
  "note": "PokemonMansion_2F_Frlg, SecretSwitch (msgbox) [non compilé]"
 },
 {
  "msgid": "Not quite yet!",
  "msgstr": "Pas encore!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonMansion_2F_Frlg/scripts.inc",
  "ligne": 40,
  "note": "PokemonMansion_2F_Frlg, DontPressSwitch (msgbox) [non compilé]"
 },
 {
  "msgid": "I can't get out!\\nThis old place is one big puzzle.",
  "msgstr": "Je n’arrive pas à sortir! Ce vieux\\nmanoir est un vrai casse-tête.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonMansion_2F_Frlg/scripts.inc",
  "ligne": 43,
  "note": "PokemonMansion_2F_Frlg, Dresseur BURGLAR_ARNIE (intro) [non compilé]"
 },
 {
  "msgid": "Oh, no!\\nMy bag of loot!",
  "msgstr": "Oh, non!\\nMon butin!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonMansion_2F_Frlg/scripts.inc",
  "ligne": 47,
  "note": "PokemonMansion_2F_Frlg, Dresseur BURGLAR_ARNIE (défaite) [non compilé]"
 },
 {
  "msgid": "The switches here open and close\\nalternating sets of doors.",
  "msgstr": "Les interrupteurs d’ici ouvrent et\\nferment des portes en alternance.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonMansion_2F_Frlg/scripts.inc",
  "ligne": 51,
  "note": "PokemonMansion_2F_Frlg, Arnie (msgbox) [non compilé]"
 },
 {
  "msgid": "Diary: July 5\\nGuyana, South America\\pA new POKéMON was discovered deep\\nin the jungle.",
  "msgstr": "Journal: 5 juillet\\nGuyana, Amérique du Sud\\pUn nouveau Pokémon a été découvert\\nau cœur de la jungle.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonMansion_2F_Frlg/scripts.inc",
  "ligne": 55,
  "note": "PokemonMansion_2F_Frlg, panneau / objet (DiaryJuly5th) [non compilé]"
 },
 {
  "msgid": "Diary: July 10\\nWe christened the newly discovered\\lPOKéMON, MEW.",
  "msgstr": "Journal: 10 juillet\\nNous avons baptisé le Pokémon\\lnouvellement découvert MEW.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonMansion_2F_Frlg/scripts.inc",
  "ligne": 61,
  "note": "PokemonMansion_2F_Frlg, panneau / objet (DiaryJuly10th) [non compilé]"
 },
 {
  "msgid": "This place is, like, huge!",
  "msgstr": "Ce manoir est, genre, immense!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonMansion_3F_Frlg/scripts.inc",
  "ligne": 34,
  "note": "PokemonMansion_3F_Frlg, Dresseur BURGLAR_SIMON (intro) [non compilé]"
 },
 {
  "msgid": "Ayah!",
  "msgstr": "Aiyah!",
  "source": "SoulSilver FR officiel (adapté)",
  "fichier": "data/maps/PokemonMansion_3F_Frlg/scripts.inc",
  "ligne": 37,
  "preuve": "SS 728:563 « Aiyah! » (anglais HGSS « Aiyah! »)",
  "note": "PokemonMansion_3F_Frlg, Dresseur BURGLAR_SIMON (défaite) [non compilé]"
 },
 {
  "msgid": "I wonder where my partner went.",
  "msgstr": "Où est passé mon complice?",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonMansion_3F_Frlg/scripts.inc",
  "ligne": 40,
  "note": "PokemonMansion_3F_Frlg, Simon (msgbox) [non compilé]"
 },
 {
  "msgid": "My mentor once lived here.",
  "msgstr": "Mon mentor a vécu ici autrefois.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonMansion_3F_Frlg/scripts.inc",
  "ligne": 43,
  "note": "PokemonMansion_3F_Frlg, Dresseur SCIENTIST_BRAYDON (intro) [non compilé]"
 },
 {
  "msgid": "Whew!\\nOverwhelming!",
  "msgstr": "Pfiou!\\nQuelle puissance!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonMansion_3F_Frlg/scripts.inc",
  "ligne": 46,
  "note": "PokemonMansion_3F_Frlg, Dresseur SCIENTIST_BRAYDON (défaite) [non compilé]"
 },
 {
  "msgid": "So, you're stuck?\\nTry jumping off over there!",
  "msgstr": "Alors, tu es coincé? Essaie de sauter\\npar là-bas!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonMansion_3F_Frlg/scripts.inc",
  "ligne": 50,
  "note": "PokemonMansion_3F_Frlg, Braydon (msgbox) ; tutoiement [non compilé]"
 },
 {
  "msgid": "Diary: Feb. 6\\nMEW gave birth.\\pWe named the newborn MEWTWO.",
  "msgstr": "Journal: 6 février\\nMEW a donné naissance à un petit.\\pNous avons appelé le nouveau-né\\nMEWTWO.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonMansion_3F_Frlg/scripts.inc",
  "ligne": 54,
  "note": "PokemonMansion_3F_Frlg, panneau / objet (DiaryFeb6th) [non compilé]"
 },
 {
  "msgid": "Uh-oh…\\nWhere am I now?",
  "msgstr": "Oh oh…\\nOù suis-je maintenant?",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonMansion_B1F_Frlg/scripts.inc",
  "ligne": 34,
  "note": "PokemonMansion_B1F_Frlg, Dresseur BURGLAR_LEWIS (intro) [non compilé]"
 },
 {
  "msgid": "Awooh!",
  "msgstr": "Aouuuh!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonMansion_B1F_Frlg/scripts.inc",
  "ligne": 38,
  "note": "PokemonMansion_B1F_Frlg, Dresseur BURGLAR_LEWIS (défaite) [non compilé]"
 },
 {
  "msgid": "You can find stuff lying around.\\nThe residents must've left them.",
  "msgstr": "On trouve des trucs qui traînent un\\npeu partout. Les habitants ont dû les\\llaisser.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonMansion_B1F_Frlg/scripts.inc",
  "ligne": 41,
  "note": "PokemonMansion_B1F_Frlg, Lewis (msgbox) [non compilé]"
 },
 {
  "msgid": "This place is ideal for a lab.\\nLook at all this space.",
  "msgstr": "Cet endroit est idéal pour un labo.\\nRegarde tout cet espace.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonMansion_B1F_Frlg/scripts.inc",
  "ligne": 45,
  "note": "PokemonMansion_B1F_Frlg, Dresseur SCIENTIST_IVAN (intro) [non compilé]"
 },
 {
  "msgid": "What was that for?",
  "msgstr": "Pourquoi tu as fait ça?",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonMansion_B1F_Frlg/scripts.inc",
  "ligne": 49,
  "note": "PokemonMansion_B1F_Frlg, Dresseur SCIENTIST_IVAN (défaite) ; tutoiement [non compilé]"
 },
 {
  "msgid": "I like it here.\\nIt's conducive to my studies.",
  "msgstr": "Je me plais ici. C’est propice à mes\\nrecherches.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonMansion_B1F_Frlg/scripts.inc",
  "ligne": 52,
  "note": "PokemonMansion_B1F_Frlg, Ivan (msgbox) [non compilé]"
 },
 {
  "msgid": "Diary: Sept. 1\\nMEWTWO is far too powerful.\\pWe have failed to curb its vicious\\ntendencies…",
  "msgstr": "Journal: 1{SUPER_ER} septembre\\nMEWTWO est bien trop puissant.\\pNous ne sommes pas parvenus à\\nréfréner sa nature violente…",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonMansion_B1F_Frlg/scripts.inc",
  "ligne": 56,
  "note": "PokemonMansion_B1F_Frlg, panneau / objet (DiarySep1st) [non compilé]"
 },
 {
  "msgid": "POKéMON TOWER was erected in the\\nmemory of POKéMON that died.",
  "msgstr": "La Tour Pokémon a été érigée en\\nmémoire des Pokémon disparus.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_1F_Frlg/scripts.inc",
  "ligne": 40,
  "note": "PokemonTower_1F_Frlg, WorkerF (msgbox) [non compilé]"
 },
 {
  "msgid": "Did you come to pay respects?\\pBless your POKéMON-loving heart,\\nson.",
  "msgstr": "Tu es venu te recueillir?\\pQue Dieu bénisse ton cœur qui aime\\ntant les Pokémon, mon garçon.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_1F_Frlg/scripts.inc",
  "ligne": 44,
  "note": "PokemonTower_1F_Frlg, Woman2MalePlayer (msgbox) ; tutoiement [non compilé]"
 },
 {
  "msgid": "Did you come to pay respects?\\pBless your POKéMON-loving heart,\\ngirl.",
  "msgstr": "Tu es venue te recueillir?\\pQue Dieu bénisse ton cœur qui aime\\ntant les Pokémon, ma petite.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_1F_Frlg/scripts.inc",
  "ligne": 49,
  "note": "PokemonTower_1F_Frlg, Woman2 (msgbox) ; tutoiement [non compilé]"
 },
 {
  "msgid": "I came to pray for my dearly\\ndeparted CLEFAIRY.\\pSniff!\\nI'm awash in tears…",
  "msgstr": "Je suis venue prier pour mon cher\\nMELOFEE disparu.\\pSnif! Je suis en larmes…",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_1F_Frlg/scripts.inc",
  "ligne": 54,
  "note": "PokemonTower_1F_Frlg, BaldingMan (msgbox) [non compilé]"
 },
 {
  "msgid": "My GROWLITHE…\\nWhy did you die?",
  "msgstr": "Mon CANINOS…\\nPourquoi es-tu mort?",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_1F_Frlg/scripts.inc",
  "ligne": 60,
  "note": "PokemonTower_1F_Frlg, Woman1 (msgbox) ; tutoiement [non compilé]"
 },
 {
  "msgid": "I am a CHANNELER.\\pThere are spirits up to mischief.\\nI sense them high in the TOWER.",
  "msgstr": "Je suis une Exorciste.\\pDes esprits font des leurs. Je les\\nsens tout en haut de la Tour.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_1F_Frlg/scripts.inc",
  "ligne": 64,
  "note": "PokemonTower_1F_Frlg, Channeler (msgbox) [non compilé]"
 },
 {
  "msgid": "{RIVAL}: Hey, {PLAYER}!\\nWhat brings you here?\\lIs your POKéMON dead?\\pHey! It's alive!\\pI can at least make them faint!\\nLet's go!",
  "msgstr": "{RIVAL}: Hé, {PLAYER}! Qu’est-ce que\\ntu fais là? Ton Pokémon est mort?\\pHé! Il est vivant!\\pJe peux au moins les mettre K.O.! C’est\\nparti!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_2F_Frlg/scripts.inc",
  "ligne": 104,
  "note": "PokemonTower_2F_Frlg, Rival (msgbox) ; tutoiement [non compilé]"
 },
 {
  "msgid": "What?\\nYou stinker!\\pI took it easy on you, too!",
  "msgstr": "Quoi? Espèce de minable!\\pEt moi qui y allais doucement avec\\ntoi!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_2F_Frlg/scripts.inc",
  "ligne": 112,
  "note": "PokemonTower_2F_Frlg, Dresseur RIVAL_POKEMON_TOWER_SQUIRTLE (défaite) [non compilé]"
 },
 {
  "msgid": "How's your POKéDEX coming?\\nI just caught a CUBONE!\\pI can't find the bigger MAROWAK.\\nWhere could they be?\\pI bet there aren't any left!\\pWell, I better get going.\\nI've got a lot to accomplish,\\lunlike you.\\pSmell ya later!",
  "msgstr": "Comment avance ton Pokédex? Je\\nviens d’attraper un OSSELAIT!\\pJe ne trouve pas d’OSSATUEUR, son\\névolution. Où peuvent-ils bien être?\\pJe parie qu’il n’en reste plus!\\pBon, je ferais mieux d’y aller. J’ai\\nplein de choses à faire, moi,\\lcontrairement à toi.\\pAllez, à la revoyure!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_2F_Frlg/scripts.inc",
  "ligne": 117,
  "note": "PokemonTower_2F_Frlg, Rival (msgbox) ; tutoiement [non compilé]"
 },
 {
  "msgid": "Even we could not identify the\\nwayward ghosts.\\pA SILPH SCOPE might be able to\\nunmask them.",
  "msgstr": "Même nous, nous n’avons pas pu\\nidentifier ces fantômes errants.\\pUn Scope Sylphe pourrait peut-être\\nles démasquer.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_2F_Frlg/scripts.inc",
  "ligne": 128,
  "note": "PokemonTower_2F_Frlg, Channeler (msgbox) [non compilé]"
 },
 {
  "msgid": "Urrg… Awaa…\\nHuhu… Graa…",
  "msgstr": "Urrg… Awaa…\\nHuhu… Graa…",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_3F_Frlg/scripts.inc",
  "ligne": 20,
  "note": "PokemonTower_3F_Frlg, Dresseur CHANNELER_HOPE (intro) [non compilé]"
 },
 {
  "msgid": "Hwa!\\nI'm saved!",
  "msgstr": "Hwa!\\nJe suis sauvée!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_3F_Frlg/scripts.inc",
  "ligne": 24,
  "note": "PokemonTower_3F_Frlg, Dresseur CHANNELER_HOPE (défaite) [non compilé]"
 },
 {
  "msgid": "The ghosts can be identified by\\nthe SILPH SCOPE.",
  "msgstr": "On peut identifier les fantômes grâce\\nau Scope Sylphe.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_3F_Frlg/scripts.inc",
  "ligne": 28,
  "note": "PokemonTower_3F_Frlg, Hope (msgbox) [non compilé]"
 },
 {
  "msgid": "Kekeke…\\nKwaaah!",
  "msgstr": "Kekeke…\\nKwaaah!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_3F_Frlg/scripts.inc",
  "ligne": 32,
  "note": "PokemonTower_3F_Frlg, Dresseur CHANNELER_CARLY (intro) [non compilé]"
 },
 {
  "msgid": "Hmm?\\nWhat am I doing?",
  "msgstr": "Hein?\\nQu’est-ce que je fais?",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_3F_Frlg/scripts.inc",
  "ligne": 36,
  "note": "PokemonTower_3F_Frlg, Dresseur CHANNELER_CARLY (défaite) [non compilé]"
 },
 {
  "msgid": "Sorry!\\nI was possessed!",
  "msgstr": "Désolée!\\nJ’étais possédée!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_3F_Frlg/scripts.inc",
  "ligne": 40,
  "note": "PokemonTower_3F_Frlg, Carly (msgbox) [non compilé]"
 },
 {
  "msgid": "Be gone!\\nMalevolent spirit!",
  "msgstr": "Disparais!\\nEsprit malfaisant!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_3F_Frlg/scripts.inc",
  "ligne": 44,
  "note": "PokemonTower_3F_Frlg, Dresseur CHANNELER_PATRICIA (intro) [non compilé]"
 },
 {
  "msgid": "Whew!\\nThe spirit left!",
  "msgstr": "Pfiou!\\nL’esprit est parti!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_3F_Frlg/scripts.inc",
  "ligne": 48,
  "note": "PokemonTower_3F_Frlg, Dresseur CHANNELER_PATRICIA (défaite) [non compilé]"
 },
 {
  "msgid": "The others above…\\nThey must have been possessed.",
  "msgstr": "Les autres, là-haut…\\nIls ont dû être possédés.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_3F_Frlg/scripts.inc",
  "ligne": 52,
  "note": "PokemonTower_3F_Frlg, Patricia (msgbox) [non compilé]"
 },
 {
  "msgid": "Ghost! No!\\nKwaaah!",
  "msgstr": "Un fantôme! Non!\\nKwaaah!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_4F_Frlg/scripts.inc",
  "ligne": 20,
  "note": "PokemonTower_4F_Frlg, Dresseur CHANNELER_PAULA (intro) [non compilé]"
 },
 {
  "msgid": "Where is the ghost?",
  "msgstr": "Où est le fantôme?",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_4F_Frlg/scripts.inc",
  "ligne": 24,
  "note": "PokemonTower_4F_Frlg, Dresseur CHANNELER_PAULA (défaite) [non compilé]"
 },
 {
  "msgid": "I must have been dreaming…",
  "msgstr": "J’ai dû rêver…",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_4F_Frlg/scripts.inc",
  "ligne": 27,
  "note": "PokemonTower_4F_Frlg, Paula (msgbox) [non compilé]"
 },
 {
  "msgid": "Be cursed with me!\\nKwaaah!",
  "msgstr": "Sois maudit avec moi!\\nKwaaah!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_4F_Frlg/scripts.inc",
  "ligne": 30,
  "note": "PokemonTower_4F_Frlg, Dresseur CHANNELER_LAUREL (intro) [non compilé]"
 },
 {
  "msgid": "We can't determine the identity of\\nthe ghosts…",
  "msgstr": "On n’arrive pas à identifier les\\nfantômes…",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_4F_Frlg/scripts.inc",
  "ligne": 37,
  "note": "PokemonTower_4F_Frlg, Laurel (msgbox) [non compilé]"
 },
 {
  "msgid": "Huhuhu…\\nBeat me not!",
  "msgstr": "Huhuhu…\\nNe me bats pas!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_4F_Frlg/scripts.inc",
  "ligne": 41,
  "note": "PokemonTower_4F_Frlg, Dresseur CHANNELER_JODY (intro) [non compilé]"
 },
 {
  "msgid": "Huh?\\nWho? What?",
  "msgstr": "Hein?\\nQui? Quoi?",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_4F_Frlg/scripts.inc",
  "ligne": 45,
  "note": "PokemonTower_4F_Frlg, Dresseur CHANNELER_JODY (défaite) [non compilé]"
 },
 {
  "msgid": "May the departed POKéMON rest in\\npeace…",
  "msgstr": "Que les Pokémon disparus reposent en\\npaix…",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_4F_Frlg/scripts.inc",
  "ligne": 49,
  "note": "PokemonTower_4F_Frlg, Jody (msgbox) [non compilé]"
 },
 {
  "msgid": "Come, child!\\nI have purified this space.\\lYou can rest here.",
  "msgstr": "Viens, mon enfant!\\nJ’ai purifié cet espace.\\lTu peux te reposer ici.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_5F_Frlg/scripts.inc",
  "ligne": 45,
  "note": "PokemonTower_5F_Frlg, Channeler (msgbox) ; tutoiement [non compilé]"
 },
 {
  "msgid": "Give…me…\\nyour…all…",
  "msgstr": "Donne…moi…\\ntout…ce que…tu as…",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_5F_Frlg/scripts.inc",
  "ligne": 50,
  "note": "PokemonTower_5F_Frlg, Dresseur CHANNELER_TAMMY (intro) ; tutoiement [non compilé]"
 },
 {
  "msgid": "Gasp!",
  "msgstr": "Ah!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_5F_Frlg/scripts.inc",
  "ligne": 54,
  "note": "PokemonTower_5F_Frlg, Dresseur CHANNELER_TAMMY (défaite) [non compilé]"
 },
 {
  "msgid": "I was under possession.",
  "msgstr": "J’étais possédée.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_5F_Frlg/scripts.inc",
  "ligne": 57,
  "note": "PokemonTower_5F_Frlg, Tammy (msgbox) [non compilé]"
 },
 {
  "msgid": "You…shall…\\njoin…us…",
  "msgstr": "Tu…vas…\\nnous…rejoindre…",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_5F_Frlg/scripts.inc",
  "ligne": 60,
  "note": "PokemonTower_5F_Frlg, Dresseur CHANNELER_RUTH (intro) ; tutoiement [non compilé]"
 },
 {
  "msgid": "What a nightmare!",
  "msgstr": "Quel cauchemar!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_5F_Frlg/scripts.inc",
  "ligne": 64,
  "note": "PokemonTower_5F_Frlg, Dresseur CHANNELER_RUTH (défaite) [non compilé]"
 },
 {
  "msgid": "I was possessed.",
  "msgstr": "J’étais possédée.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_5F_Frlg/scripts.inc",
  "ligne": 67,
  "note": "PokemonTower_5F_Frlg, Ruth (msgbox) [non compilé]"
 },
 {
  "msgid": "Zombies!",
  "msgstr": "Des zombies!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_5F_Frlg/scripts.inc",
  "ligne": 70,
  "note": "PokemonTower_5F_Frlg, Dresseur CHANNELER_KARINA (intro) [non compilé]"
 },
 {
  "msgid": "Ha?",
  "msgstr": "Hein?",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_5F_Frlg/scripts.inc",
  "ligne": 73,
  "note": "PokemonTower_5F_Frlg, Dresseur CHANNELER_KARINA (défaite) [non compilé]"
 },
 {
  "msgid": "I regained my senses.",
  "msgstr": "J’ai repris mes esprits.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_5F_Frlg/scripts.inc",
  "ligne": 76,
  "note": "PokemonTower_5F_Frlg, Karina (msgbox) [non compilé]"
 },
 {
  "msgid": "Urgah…\\nUrff…",
  "msgstr": "Urgah…\\nUrff…",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_5F_Frlg/scripts.inc",
  "ligne": 79,
  "note": "PokemonTower_5F_Frlg, Dresseur CHANNELER_JANAE (intro) [non compilé]"
 },
 {
  "msgid": "Whoo!",
  "msgstr": "Wouh!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_5F_Frlg/scripts.inc",
  "ligne": 83,
  "note": "PokemonTower_5F_Frlg, Dresseur CHANNELER_JANAE (défaite) [non compilé]"
 },
 {
  "msgid": "I fell to evil spirits despite my\\ntraining in the mountains…",
  "msgstr": "J’ai succombé aux esprits malfaisants\\nmalgré mon entraînement dans les\\lmontagnes…",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_5F_Frlg/scripts.inc",
  "ligne": 86,
  "note": "PokemonTower_5F_Frlg, Janae (msgbox) [non compilé]"
 },
 {
  "msgid": "Entered the purified and protected\\nzone.\\p{PLAYER}'s POKéMON were fully\\nhealed.",
  "msgstr": "Vous entrez dans la zone purifiée et\\nprotégée.\\pLes Pokémon de {PLAYER} sont\\ncomplètement soignés.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_5F_Frlg/scripts.inc",
  "ligne": 90,
  "note": "PokemonTower_5F_Frlg, PurifiedZone (msgbox) ; vouvoiement [non compilé]"
 },
 {
  "msgid": "Give…me…\\nblood…",
  "msgstr": "Donne…moi…\\ndu sang…",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_6F_Frlg/scripts.inc",
  "ligne": 49,
  "note": "PokemonTower_6F_Frlg, Dresseur CHANNELER_ANGELICA (intro) [non compilé]"
 },
 {
  "msgid": "Groan!",
  "msgstr": "Grrr!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_6F_Frlg/scripts.inc",
  "ligne": 53,
  "note": "PokemonTower_6F_Frlg, Dresseur CHANNELER_ANGELICA (défaite) [non compilé]"
 },
 {
  "msgid": "I feel anemic and weak…",
  "msgstr": "Je me sens anémiée et faible…",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_6F_Frlg/scripts.inc",
  "ligne": 56,
  "note": "PokemonTower_6F_Frlg, Angelica (msgbox) [non compilé]"
 },
 {
  "msgid": "Urff…\\nKwaah!",
  "msgstr": "Urff…\\nKwaah!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_6F_Frlg/scripts.inc",
  "ligne": 59,
  "note": "PokemonTower_6F_Frlg, Dresseur CHANNELER_EMILIA (intro) [non compilé]"
 },
 {
  "msgid": "Something fell out!",
  "msgstr": "Il y a quelque chose qui est tombé!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_6F_Frlg/scripts.inc",
  "ligne": 63,
  "note": "PokemonTower_6F_Frlg, Dresseur CHANNELER_EMILIA (défaite) [non compilé]"
 },
 {
  "msgid": "My hair didn't fall out!\\nIt was a malevolent spirit!",
  "msgstr": "Ce ne sont pas mes cheveux qui sont\\ntombés! C’était un esprit malfaisant!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_6F_Frlg/scripts.inc",
  "ligne": 66,
  "note": "PokemonTower_6F_Frlg, Emilia (msgbox) [non compilé]"
 },
 {
  "msgid": "Ke…ke…ke…\\nke…ke…ke!",
  "msgstr": "Ke…ke…ke…\\nke…ke…ke!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_6F_Frlg/scripts.inc",
  "ligne": 70,
  "note": "PokemonTower_6F_Frlg, Dresseur CHANNELER_JENNIFER (intro) [non compilé]"
 },
 {
  "msgid": "Keee!",
  "msgstr": "Hiiii!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_6F_Frlg/scripts.inc",
  "ligne": 74,
  "note": "PokemonTower_6F_Frlg, Dresseur CHANNELER_JENNIFER (défaite) [non compilé]"
 },
 {
  "msgid": "What's going on here?",
  "msgstr": "Qu’est-ce qui se passe ici?",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_6F_Frlg/scripts.inc",
  "ligne": 77,
  "note": "PokemonTower_6F_Frlg, Jennifer (msgbox) [non compilé]"
 },
 {
  "msgid": "Be gone…\\nIntruders…",
  "msgstr": "Partez…\\nIntrus…",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_6F_Frlg/scripts.inc",
  "ligne": 80,
  "note": "PokemonTower_6F_Frlg, MarowakGhost (msgbox) [non compilé]"
 },
 {
  "msgid": "The ghost was the restless spirit\\nof CUBONE's mother!",
  "msgstr": "Le fantôme était l’esprit tourmenté\\nde la mère d’OSSELAIT!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_6F_Frlg/scripts.inc",
  "ligne": 84,
  "note": "PokemonTower_6F_Frlg, DefeatedMarowakGhost (message) [non compilé]"
 },
 {
  "msgid": "The mother's spirit was calmed.\\pIt departed to the afterlife…",
  "msgstr": "L’esprit de la mère s’est apaisé.\\pIl est parti dans l’au-delà…",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_6F_Frlg/scripts.inc",
  "ligne": 88,
  "note": "PokemonTower_6F_Frlg, DefeatedMarowakGhost (msgbox) [non compilé]"
 },
 {
  "msgid": "What do you want?\\nWhy are you here?",
  "msgstr": "Qu’est-ce que tu veux? Qu’est-ce que\\ntu fais ici?",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_7F_Frlg/scripts.inc",
  "ligne": 234,
  "note": "PokemonTower_7F_Frlg, Dresseur TEAM_ROCKET_GRUNT_19 (intro) ; tutoiement [non compilé]"
 },
 {
  "msgid": "I'm not going to forget this!",
  "msgstr": "Je ne vais pas oublier ça!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_7F_Frlg/scripts.inc",
  "ligne": 241,
  "note": "PokemonTower_7F_Frlg, DefeatedGrunt1 (msgbox) [non compilé]"
 },
 {
  "msgid": "This old guy marched right up to\\nour HIDEOUT.\\pThen, he starts ranting about how\\nTEAM ROCKET's abusing POKéMON.\\pSo, we're just talking it over as\\nadults.",
  "msgstr": "Ce vieux bonhomme a débarqué dans\\nnotre repaire.\\pEt le voilà qui se met à râler parce\\nque la Team Rocket maltraite les\\lPokémon.\\pAlors on en discute entre adultes.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_7F_Frlg/scripts.inc",
  "ligne": 244,
  "note": "PokemonTower_7F_Frlg, Dresseur TEAM_ROCKET_GRUNT_20 (intro) ; phrase harmonisée avec la fiche Mémorydex du lot D1 (fame_checker_frlg.inc) [non compilé]"
 },
 {
  "msgid": "Please!\\nNo more!",
  "msgstr": "Pitié!\\nArrête!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_7F_Frlg/scripts.inc",
  "ligne": 252,
  "note": "PokemonTower_7F_Frlg, Dresseur TEAM_ROCKET_GRUNT_20 (défaite) [non compilé]"
 },
 {
  "msgid": "POKéMON are only good for making\\nmoney. Why not use them?\\pYou stay out of our business!",
  "msgstr": "Les Pokémon, ça sert juste à faire du\\nfric. Pourquoi s’en priver?\\pNe te mêle pas de nos affaires!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_7F_Frlg/scripts.inc",
  "ligne": 256,
  "note": "PokemonTower_7F_Frlg, DefeatedGrunt2 (msgbox) ; tutoiement [non compilé]"
 },
 {
  "msgid": "You're not saving anyone, kid!",
  "msgstr": "Tu ne sauveras personne, gamin!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_7F_Frlg/scripts.inc",
  "ligne": 261,
  "note": "PokemonTower_7F_Frlg, Dresseur TEAM_ROCKET_GRUNT_21 (intro) ; tutoiement [non compilé]"
 },
 {
  "msgid": "Don't fight us ROCKETS!",
  "msgstr": "Ne te frotte pas à la Team Rocket!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_7F_Frlg/scripts.inc",
  "ligne": 264,
  "note": "PokemonTower_7F_Frlg, Dresseur TEAM_ROCKET_GRUNT_21 (défaite) ; tutoiement [non compilé]"
 },
 {
  "msgid": "You're not getting away with this!",
  "msgstr": "Tu ne vas pas t’en tirer comme ça!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_7F_Frlg/scripts.inc",
  "ligne": 267,
  "note": "PokemonTower_7F_Frlg, DefeatedGrunt3 (msgbox) ; tutoiement [non compilé]"
 },
 {
  "msgid": "MR. FUJI: Heh?\\nYou came to save me?\\pThank you. But, I came here of my\\nown free will.\\pI came to calm the spirit of\\nCUBONE's mother.\\pI think MAROWAK's spirit has\\nfinally left us.\\pI must thank you for your kind\\nconcern.\\pFollow me to my home, POKéMON\\nHOUSE, at the foot of this tower.",
  "msgstr": "M. Fuji: Hein? Tu es venu me sauver?\\pMerci. Mais je suis venu ici de mon\\nplein gré.\\pJe suis venu apaiser l’esprit de la\\nmère d’OSSELAIT.\\pJe pense que l’esprit de l’OSSATUEUR\\nnous a enfin quittés.\\pJe dois te remercier pour ta gentille\\nsollicitude.\\pSuis-moi jusque chez moi, au\\nBénévolat de Lavanville, au pied de\\lcette tour.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/PokemonTower_7F_Frlg/scripts.inc",
  "ligne": 270,
  "note": "PokemonTower_7F_Frlg, MrFuji (msgbox) ; tutoiement ; POKéMON HOUSE = Bénévolat de Lavanville (SoulSilver FR, banque 475) [non compilé]"
 },
 {
  "msgid": "This tunnel goes a long way, kid!",
  "msgstr": "Ce tunnel est très long, gamin!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_1F_Frlg/scripts.inc",
  "ligne": 49,
  "note": "RockTunnel_1F_Frlg, Dresseur HIKER_LENNY (intro) [non compilé]"
 },
 {
  "msgid": "Doh!\\nYou win!",
  "msgstr": "Oh!\\nT’as gagné!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_1F_Frlg/scripts.inc",
  "ligne": 52,
  "note": "RockTunnel_1F_Frlg, Dresseur HIKER_LENNY (défaite) [non compilé]"
 },
 {
  "msgid": "Watch for ONIX.\\nThey appear only occasionally.\\pHigh-level ones can put the\\nsqueeze on you!",
  "msgstr": "Fais attention aux ONIX. Ils\\nn’apparaissent que de temps en temps.\\pCeux de haut niveau peuvent te\\nserrer très fort!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_1F_Frlg/scripts.inc",
  "ligne": 56,
  "note": "RockTunnel_1F_Frlg, Lenny (msgbox) ; tutoiement [non compilé]"
 },
 {
  "msgid": "Hmm.\\nMaybe I'm lost in here…",
  "msgstr": "Hmm.\\nJe me suis peut-être perdu…",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_1F_Frlg/scripts.inc",
  "ligne": 62,
  "note": "RockTunnel_1F_Frlg, Dresseur HIKER_OLIVER (intro) [non compilé]"
 },
 {
  "msgid": "Ease up!\\nWhat am I doing?\\lWhich way is out?",
  "msgstr": "Doucement!\\nQu’est-ce que je fais?\\lC’est par où, la sortie?",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_1F_Frlg/scripts.inc",
  "ligne": 66,
  "note": "RockTunnel_1F_Frlg, Dresseur HIKER_OLIVER (défaite) [non compilé]"
 },
 {
  "msgid": "That sleeping POKéMON on ROUTE 12\\nforced me to take this detour.",
  "msgstr": "Ce Pokémon endormi sur la Route 12 m’a\\nforcé à faire ce détour.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_1F_Frlg/scripts.inc",
  "ligne": 71,
  "note": "RockTunnel_1F_Frlg, Oliver (msgbox) [non compilé]"
 },
 {
  "msgid": "Outsiders like you need to show me\\nsome respect!",
  "msgstr": "Les étrangers comme toi doivent me\\nmontrer du respect!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_1F_Frlg/scripts.inc",
  "ligne": 75,
  "note": "RockTunnel_1F_Frlg, Dresseur HIKER_LUCAS (intro) ; tutoiement [non compilé]"
 },
 {
  "msgid": "You're talented enough to hike!",
  "msgstr": "Tu as assez de talent pour faire\\nde la randonnée!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_1F_Frlg/scripts.inc",
  "ligne": 82,
  "note": "RockTunnel_1F_Frlg, Lucas (msgbox) ; tutoiement [non compilé]"
 },
 {
  "msgid": "POKéMON fight!\\nReady, go!",
  "msgstr": "Combat Pokémon!\\nPrêt? Partez!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_1F_Frlg/scripts.inc",
  "ligne": 85,
  "note": "RockTunnel_1F_Frlg, Dresseur POKEMANIAC_ASHTON (intro) [non compilé]"
 },
 {
  "msgid": "Oh well, I'll get a ZUBAT as I go!",
  "msgstr": "Tant pis, j’attraperai un\\nNOSFERAPTI en route!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_1F_Frlg/scripts.inc",
  "ligne": 92,
  "note": "RockTunnel_1F_Frlg, Ashton (msgbox) [non compilé]"
 },
 {
  "msgid": "Eek!\\pDon't try anything funny in the\\ndark!",
  "msgstr": "Hiii!\\pN’essaie pas de faire des bêtises\\ndans le noir!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_1F_Frlg/scripts.inc",
  "ligne": 95,
  "note": "RockTunnel_1F_Frlg, Dresseur PICNICKER_LEAH (intro) [non compilé]"
 },
 {
  "msgid": "It was too dark…",
  "msgstr": "Il faisait trop sombre…",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_1F_Frlg/scripts.inc",
  "ligne": 100,
  "note": "RockTunnel_1F_Frlg, Dresseur PICNICKER_LEAH (défaite) [non compilé]"
 },
 {
  "msgid": "I saw a MACHOP in this tunnel.",
  "msgstr": "J’ai vu un MACHOC dans ce tunnel.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_1F_Frlg/scripts.inc",
  "ligne": 103,
  "note": "RockTunnel_1F_Frlg, Leah (msgbox) [non compilé]"
 },
 {
  "msgid": "I came this far looking for wild\\nPOKéMON.",
  "msgstr": "Je suis venue jusqu’ici pour chercher\\ndes Pokémon sauvages.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_1F_Frlg/scripts.inc",
  "ligne": 106,
  "note": "RockTunnel_1F_Frlg, Dresseur PICNICKER_DANA (intro) [non compilé]"
 },
 {
  "msgid": "I'm out of POKéMON!",
  "msgstr": "Je n’ai plus de Pokémon!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_1F_Frlg/scripts.inc",
  "ligne": 110,
  "note": "RockTunnel_1F_Frlg, Dresseur PICNICKER_DANA (défaite) [non compilé]"
 },
 {
  "msgid": "You looked cute and harmless.\\nWas I ever wrong!",
  "msgstr": "Tu avais l’air mignon et inoffensif.\\nQu’est-ce que je me suis trompée!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_1F_Frlg/scripts.inc",
  "ligne": 113,
  "note": "RockTunnel_1F_Frlg, Dana (msgbox) ; tutoiement [non compilé]"
 },
 {
  "msgid": "You have POKéMON!\\nLet's start!",
  "msgstr": "Tu as des Pokémon!\\nAllons-y!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_1F_Frlg/scripts.inc",
  "ligne": 117,
  "note": "RockTunnel_1F_Frlg, Dresseur PICNICKER_ARIANA (intro) ; tutoiement [non compilé]"
 },
 {
  "msgid": "You play hard!",
  "msgstr": "Tu ne fais pas semblant!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_1F_Frlg/scripts.inc",
  "ligne": 121,
  "note": "RockTunnel_1F_Frlg, Dresseur PICNICKER_ARIANA (défaite) ; tutoiement [non compilé]"
 },
 {
  "msgid": "Whew!\\nI'm all sweaty now.",
  "msgstr": "Pfiou!\\nJe suis toute en sueur.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_1F_Frlg/scripts.inc",
  "ligne": 124,
  "note": "RockTunnel_1F_Frlg, Ariana (msgbox) [non compilé]"
 },
 {
  "msgid": "ROCK TUNNEL\\nCERULEAN CITY - LAVENDER TOWN",
  "msgstr": "Grotte\\nAzuria - Lavanville",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_1F_Frlg/scripts.inc",
  "ligne": 128,
  "note": "RockTunnel_1F_Frlg, panneau / objet (RouteSign) [non compilé]"
 },
 {
  "msgid": "Do you know how you can avoid\\ngetting lost in the mountains?\\pYou can bend twigs as trail\\nmarkers.",
  "msgstr": "Tu sais comment éviter de te perdre\\nen montagne?\\pTu peux plier des brindilles pour\\nbaliser le chemin.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 45,
  "note": "RockTunnel_B1F_Frlg, Dresseur PICNICKER_SOFIA (intro) ; tutoiement [non compilé]"
 },
 {
  "msgid": "Ohhh!\\nI did my best!",
  "msgstr": "Ohhh!\\nJ’ai fait de mon mieux!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 51,
  "note": "RockTunnel_B1F_Frlg, Dresseur PICNICKER_SOFIA (défaite) [non compilé]"
 },
 {
  "msgid": "I want to go home!",
  "msgstr": "Je veux rentrer chez moi!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 55,
  "note": "RockTunnel_B1F_Frlg, Sofia (msgbox) [non compilé]"
 },
 {
  "msgid": "Hahaha!\\nCan you beat my power?",
  "msgstr": "Hahaha!\\nTu peux vaincre ma puissance?",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 58,
  "note": "RockTunnel_B1F_Frlg, Dresseur HIKER_DUDLEY (intro) [non compilé]"
 },
 {
  "msgid": "Oops!\\nOutmuscled!",
  "msgstr": "Oups!\\nTrop costaud!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 62,
  "note": "RockTunnel_B1F_Frlg, Dresseur HIKER_DUDLEY (défaite) [non compilé]"
 },
 {
  "msgid": "I go for power because I hate\\nthinking.",
  "msgstr": "Je mise sur la puissance parce que je\\ndéteste réfléchir.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 66,
  "note": "RockTunnel_B1F_Frlg, Dudley (msgbox) [non compilé]"
 },
 {
  "msgid": "You have a POKéDEX?\\nI want one, too.",
  "msgstr": "Tu as un Pokédex?\\nJ’en veux un, moi aussi.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 70,
  "note": "RockTunnel_B1F_Frlg, Dresseur POKEMANIAC_COOPER (intro) ; tutoiement [non compilé]"
 },
 {
  "msgid": "Shoot!\\nI am so jealous!",
  "msgstr": "Zut!\\nJe suis trop jaloux!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 74,
  "note": "RockTunnel_B1F_Frlg, Dresseur POKEMANIAC_COOPER (défaite) [non compilé]"
 },
 {
  "msgid": "When you finish your POKéDEX,\\ncan I have it?",
  "msgstr": "Quand tu auras fini ton Pokédex, je\\npourrai l’avoir?",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 78,
  "note": "RockTunnel_B1F_Frlg, Cooper (msgbox) ; tutoiement [non compilé]"
 },
 {
  "msgid": "Um… Do you know about POKéMON\\ncosplay?",
  "msgstr": "Euh… Tu connais le cosplay Pokémon?",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 82,
  "note": "RockTunnel_B1F_Frlg, Dresseur POKEMANIAC_STEVE (intro) ; tutoiement [non compilé]"
 },
 {
  "msgid": "Well, that's that.",
  "msgstr": "Bon, ben voilà.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 86,
  "note": "RockTunnel_B1F_Frlg, Dresseur POKEMANIAC_STEVE (défaite) [non compilé]"
 },
 {
  "msgid": "POKéMON cosplay is dressing up as\\nPOKéMON for fun.\\pCLEFAIRY is a favorite.",
  "msgstr": "Le cosplay Pokémon, c’est se déguiser\\nen Pokémon pour s’amuser.\\pMELOFEE est l’un des favoris.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 89,
  "note": "RockTunnel_B1F_Frlg, Steve (msgbox) [non compilé]"
 },
 {
  "msgid": "My POKéMON techniques will leave\\nyou crying!",
  "msgstr": "Mes techniques Pokémon vont te\\nfaire pleurer!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 94,
  "note": "RockTunnel_B1F_Frlg, Dresseur HIKER_ALLEN (intro) ; tutoiement [non compilé]"
 },
 {
  "msgid": "I give!\\nYou're a better technician!",
  "msgstr": "J’abandonne!\\nTu as plus de technique!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 98,
  "note": "RockTunnel_B1F_Frlg, Dresseur HIKER_ALLEN (défaite) [non compilé]"
 },
 {
  "msgid": "In mountains, you'll often find\\nROCK-type POKéMON.",
  "msgstr": "En montagne, on trouve souvent des\\nPokémon de type Roche.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 102,
  "note": "RockTunnel_B1F_Frlg, Allen (msgbox) [non compilé]"
 },
 {
  "msgid": "I don't often come here, but I will\\nbattle you.",
  "msgstr": "Je ne viens pas souvent ici, mais je\\nvais t’affronter.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 106,
  "note": "RockTunnel_B1F_Frlg, Dresseur PICNICKER_MARTHA (intro) ; tutoiement [non compilé]"
 },
 {
  "msgid": "Oh!\\nI lost!",
  "msgstr": "Oh!\\nJ’ai perdu!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 110,
  "note": "RockTunnel_B1F_Frlg, Dresseur PICNICKER_MARTHA (défaite) [non compilé]"
 },
 {
  "msgid": "I like tiny POKéMON.\\nBig ones are too scary!",
  "msgstr": "J’aime les petits Pokémon. Les gros\\nfont trop peur!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 114,
  "note": "RockTunnel_B1F_Frlg, Martha (msgbox) [non compilé]"
 },
 {
  "msgid": "Hit me with your best shot!",
  "msgstr": "Vas-y, donne tout ce que tu as!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 118,
  "note": "RockTunnel_B1F_Frlg, Dresseur HIKER_ERIC (intro) ; tutoiement [non compilé]"
 },
 {
  "msgid": "Fired away!",
  "msgstr": "Je suis grillé!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 121,
  "note": "RockTunnel_B1F_Frlg, Dresseur HIKER_ERIC (défaite) [non compilé]"
 },
 {
  "msgid": "I'll raise my POKéMON to beat\\nyours, kid.",
  "msgstr": "J’entraînerai mes Pokémon pour\\nbattre les tiens, gamin.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 124,
  "note": "RockTunnel_B1F_Frlg, Eric (msgbox) [non compilé]"
 },
 {
  "msgid": "I draw illustrations of POKéMON\\nwhen I'm home.",
  "msgstr": "Je dessine des illustrations de\\nPokémon quand je suis chez moi.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 128,
  "note": "RockTunnel_B1F_Frlg, Dresseur POKEMANIAC_WINSTON (intro) [non compilé]"
 },
 {
  "msgid": "Whew…\\nI'm exhausted…",
  "msgstr": "Pfiou…\\nJe suis épuisé…",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 132,
  "note": "RockTunnel_B1F_Frlg, Dresseur POKEMANIAC_WINSTON (défaite) [non compilé]"
 },
 {
  "msgid": "I'm an artist, not a fighter.\\nI'll go home to draw.",
  "msgstr": "Je suis un artiste, pas un\\ncombattant. Je rentre dessiner.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RockTunnel_B1F_Frlg/scripts.inc",
  "ligne": 136,
  "note": "RockTunnel_B1F_Frlg, Winston (msgbox) [non compilé]"
 },
 {
  "msgid": "Who are you?\\nHow did you get here?",
  "msgstr": "Qui es-tu? Comment es-tu arrivé ici?",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RocketHideout_B1F_Frlg/scripts.inc",
  "ligne": 66,
  "note": "RocketHideout_B1F_Frlg, Dresseur TEAM_ROCKET_GRUNT_8 (intro) ; tutoiement [non compilé]"
 },
 {
  "msgid": "Oww!\\nBeaten!",
  "msgstr": "Aïe!\\nBattu!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RocketHideout_B1F_Frlg/scripts.inc",
  "ligne": 70,
  "note": "RocketHideout_B1F_Frlg, Dresseur TEAM_ROCKET_GRUNT_8 (défaite) [non compilé]"
 },
 {
  "msgid": "Blast it… You're dissing TEAM\\nROCKET, aren't you?",
  "msgstr": "Bon sang… Tu te moques de la Team\\nRocket, c’est ça?",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RocketHideout_B1F_Frlg/scripts.inc",
  "ligne": 74,
  "note": "RocketHideout_B1F_Frlg, Grunt1 (msgbox) ; tutoiement [non compilé]"
 },
 {
  "msgid": "You broke into TEAM ROCKET's\\noperation? What nerve!",
  "msgstr": "Tu t’es introduit dans une opération\\nde la Team Rocket? Quel culot!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RocketHideout_B1F_Frlg/scripts.inc",
  "ligne": 78,
  "note": "RocketHideout_B1F_Frlg, Dresseur TEAM_ROCKET_GRUNT_9 (intro) ; tutoiement [non compilé]"
 },
 {
  "msgid": "You're not going to get away with\\nthis, brat!",
  "msgstr": "Tu ne vas pas t’en tirer comme ça,\\nmorveux!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RocketHideout_B1F_Frlg/scripts.inc",
  "ligne": 85,
  "note": "RocketHideout_B1F_Frlg, Grunt2 (msgbox) ; tutoiement [non compilé]"
 },
 {
  "msgid": "Intruder alert!",
  "msgstr": "Alerte! Un intrus!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RocketHideout_B1F_Frlg/scripts.inc",
  "ligne": 89,
  "note": "RocketHideout_B1F_Frlg, Dresseur TEAM_ROCKET_GRUNT_10 (intro) [non compilé]"
 },
 {
  "msgid": "I can't do it!",
  "msgstr": "Je n’y arrive pas!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RocketHideout_B1F_Frlg/scripts.inc",
  "ligne": 92,
  "note": "RocketHideout_B1F_Frlg, Dresseur TEAM_ROCKET_GRUNT_10 (défaite) [non compilé]"
 },
 {
  "msgid": "SILPH SCOPE? Humph!\\nI don't know where it is.",
  "msgstr": "Le Scope Sylphe? Hmph!\\nJe ne sais pas où il est.",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RocketHideout_B1F_Frlg/scripts.inc",
  "ligne": 95,
  "note": "RocketHideout_B1F_Frlg, Grunt3 (msgbox) [non compilé]"
 },
 {
  "msgid": "Why did you come here?",
  "msgstr": "Qu’est-ce que tu viens faire ici?",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RocketHideout_B1F_Frlg/scripts.inc",
  "ligne": 99,
  "note": "RocketHideout_B1F_Frlg, Dresseur TEAM_ROCKET_GRUNT_11 (intro) ; tutoiement [non compilé]"
 },
 {
  "msgid": "This won't do!",
  "msgstr": "Ça ne va pas du tout!",
  "source": "traduction nouvelle",
  "fichier": "data/maps/RocketHideout_B1F_Frlg/scripts.inc",
  "ligne": 102,
  "note": "RocketHideout_B1F_Frlg, Dresseur TEAM_ROCKET_GRUNT_11 (défaite) [non compilé]"
 }
]