msgid "Hwaah!\\pYou're trespassing in our\\nFIGHTING DOJO!"
msgstr "Ayah!\\pTu joues avec ta vie!\\nCe Dojo, c’est pour les balèzes!"

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x19A879 (pokefirered SaffronCity_Dojo_Text_HitoshiDefeat,
#. BPRE 0x19B40F, ptr) : Ouille!\nJ’suis KO!
#. ancien (traduction nouvelle) : Ouh! J’abandonne!
#: data/maps/SaffronCity_Dojo_Frlg/scripts.inc:219
msgid "Oof!\\nI give up!"
msgstr "Ouille!\\nJ’suis KO!"

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x19A88C (pokefirered
#. SaffronCity_Dojo_Text_HitoshiPostBattle, BPRE 0x19B41F, ptr) : Les
#. meilleurs combattants\ndu pays sont ici!
#. ancien (traduction nouvelle) : Les meilleurs combattants du
#. pays\ns’entraînent ici.
#: data/maps/SaffronCity_Dojo_Frlg/scripts.inc:223
msgid "The prime fighters across the land\\ntrain here."
msgstr "Les meilleurs combattants\\ndu pays sont ici!"

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x19A8B8 (pokefirered SaffronCity_Dojo_Text_YouWantHitmonlee,
