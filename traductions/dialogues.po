msgstr "Ha! Je sombre!"

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x1742CD (pokefirered SSAnne_B1F_Room4_Text_DuncanPostBattle,
#. BPRE 0x1743C8, ptr) : As-tu rencontré le MAITRE PECHEUR\nà CARMIN SUR MER?
#. ancien (traduction nouvelle) : Tu as vu le Maître Pêcheur de Carmin\nsur
#. Mer?
#: data/maps/SSAnne_B1F_Room4_Frlg/scripts.inc:34
msgid "Did you see the FISHING GURU in\\nVERMILION CITY?"
msgstr "As-tu rencontré le Maître Pêcheur\\nà Carmin sur Mer?"

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x18ECB4 (pokefirered
#. ViridianCity_House_Text_NicknamingIsFun, BPRE 0x18F292, ptr) : Trouver des
#. noms, c’est rigolo mais\nc’est dur!\pLes noms les plus simples sont
#. les\nplus faciles à retenir.
#. ancien (traduction nouvelle) : Trouver des surnoms, c’est amusant,\nmais ce
#. n’est pas si facile.\pUn nom astucieux, c’est bien, mais un\nnom simple se
#. retient mieux.
#: data/maps/ViridianCity_House_Frlg/scripts.inc:27
msgid ""
"Coming up with nicknames is fun,\\nbut it's not so easy to do.\\pClever "
"names are nice, but simple\\nnames are easier to remember."
msgstr ""
"Trouver des noms, c’est rigolo mais\\nc’est dur!\\pLes noms les plus simples"
" sont les\\nplus faciles à retenir."

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x18ED1E (pokefirered
#. ViridianCity_House_Text_MyDaddyLovesMonsToo, BPRE 0x18F30F, ptr) : Mon papa
#. aime les POKéMON aussi.
#. ancien (traduction nouvelle) : Mon papa aime aussi les Pokémon.
#: data/maps/ViridianCity_House_Frlg/scripts.inc:33
msgid "My daddy loves POKéMON, too."
msgstr "Mon papa aime les Pokémon aussi."

#. source : Rouge Feu FR officiel (adapté)
#. lot : F_frlg
#. preuve : BPRF 0x18ED3F (pokefirered ViridianCity_House_Text_Speary, BPRE
#. 0x18F32C, ptr) : PIAFFY: Cui-cui!
#. ancien (traduction nouvelle) : PIAFI: Tuituit!
#: data/maps/ViridianCity_House_Frlg/scripts.inc:36
msgid "SPEARY: Tetweet!"
msgstr "Piaffy: Cui-cui!"

#. source : Rouge Feu FR officiel (adapté)
#. lot : F_frlg
#. preuve : BPRF 0x18ED50 (pokefirered
#. ViridianCity_House_Text_SpearowNameSpeary, BPRE 0x18F33D, ptr) :
