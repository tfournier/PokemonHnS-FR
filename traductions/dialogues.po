#. source : SoulSilver FR officiel
#: data/maps/SafariZone_North_Frlg/scripts.inc:32
msgid "AREA 2"
msgstr "Area 2"

#. source : Rouge Feu FR officiel (adapté)
#. lot : F_frlg
#. preuve : BPRF 0x17779C (pokefirered
#. SafariZone_North_Text_ZigzagThroughTallGrass, BPRE 0x1778DD, ptr) :
#. ASTUCE\pLes POKéMON se cachent dans les\nhautes herbes!\pExplorez ces zones
#. pour les faire\nsortir.
#. ancien (traduction nouvelle) : Conseils aux Dresseurs\pLes Pokémon se
#. cachent dans les\nhautes herbes.\pZigzaguez dans les herbes pour
#. les\ndébusquer.
#: data/maps/SafariZone_North_Frlg/scripts.inc:35
