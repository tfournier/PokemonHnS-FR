msgstr "J’étais possédée!"

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x179EFE (pokefirered PokemonTower_5F_Text_KarinaIntro, BPRE
#. 0x17A187, ptr) : Zombis!
#. ancien (traduction nouvelle) : Des zombies!
#: data/maps/PokemonTower_5F_Frlg/scripts.inc:70
msgid "Zombies!"
msgstr "Zombis!"

#. source : traduction nouvelle
#. lot : D3a_dialogues
#: data/maps/PokemonTower_5F_Frlg/scripts.inc:73
msgid "Ha?"
msgstr "Hein?"

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x179F0C (pokefirered PokemonTower_5F_Text_KarinaPostBattle,
#. BPRE 0x17A194, ptr) : Je suis revenue à la raison!
#. ancien (traduction nouvelle) : J’ai repris mes esprits.
#: data/maps/PokemonTower_5F_Frlg/scripts.inc:76
