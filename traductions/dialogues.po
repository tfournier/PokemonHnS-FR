#. ancien (traduction nouvelle) : J’ai senti ton approche.
#: data/maps/SevenIsland_TrainerTower_Frlg/scripts.inc:18
#: data/text/trainers_frlg.inc:911
msgid "I sensed your approach."
msgstr "Je savais que tu viendrais."

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x18BDAD (pokefirered
#. SevenIsland_TrainerTower_Text_RodetteIntro, BPRE 0x18C283, ptr) : Quelque
#. part sur cette île, des\nPOKéMON spéciaux se reposent.
#. ancien (traduction nouvelle) : Quelque part sur cette île dorment\ndes
#. Pokémon étranges.
#: data/maps/SevenIsland_TrainerTower_Frlg/scripts.inc:30
#: data/text/trainers_frlg.inc:914
msgid "Somewhere on this island, peculiar\\nPOKéMON are sleeping."
msgstr "Quelque part sur cette île, des\\nPokémon spéciaux se reposent."

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x1C2AC7 (pokefirered
#. SevenIsland_SevaultCanyon_Entrance_Text_MiahRematchIntro, BPRE 0x1C4327,
