#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x1764CB (pokefirered SilphCo_7F_Text_Grunt3PostBattle, BPRE
#. 0x1765B1, ptr) : Tu ne pourras pas trouver mon\nchef juste en te baladant!
#. ancien (traduction nouvelle) : Tu ne trouveras pas mon Boss en\ncourant
#. dans tous les sens!
#: data/maps/SilphCo_7F_Frlg/scripts.inc:296
msgid "You won't find my BOSS by just\\nscurrying around!"
msgstr "Tu ne pourras pas trouver mon\\nchef juste en te baladant!"

#. source : Rouge Feu FR officiel (adapté)
#. lot : F_frlg
#. preuve : BPRF 0x176504 (pokefirered SilphCo_7F_Text_JoshuaIntro, BPRE
#. 0x1765E2, ptr) : Nyah ha ha!\pTu me prends pour un employé de\nla SYLPHE?
#. ancien (traduction nouvelle) : Héhé!\pTu m’as pris pour un employé de
#. la\nSylphe?
#: data/maps/SilphCo_7F_Frlg/scripts.inc:300
msgid "Heheh!\\pYou mistook me for a SILPH worker?"
msgstr "Nyah ha ha!\\pTu me prends pour un employé de\\nla Sylphe?"

#. source : Rouge Feu FR officiel (adapté)
#. lot : F_frlg
#. preuve : BPRF 0x17653B (pokefirered SilphCo_7F_Text_JoshuaDefeat, BPRE
#. 0x17660C, ptr) : …\nFichu!
