#. source : patch FR actuel
#: data/maps/GoldenrodCity_GameCorner_hns/scripts.inc:817
msgid "ABOUT NOTES"
msgstr "LES MEMOS"

#. source : patch FR actuel
#: data/maps/GoldenrodCity_GameCorner_hns/scripts.inc:824
msgid "Welcome to VOLTORB FLIP!\\p"
msgstr "Bienvenue au VOLTORBATAILLE!\\p"

#. source : SoulSilver FR officiel
#. lot : B_soulsilver
#. preuve : 39:15 — Jouer à Voltorbataille niveau {STRVAR_1 50, 0, 0}?
#. ancien (patch FR actuel) : VOLTORBATAILLE niveau {STR_VAR_1}?
#: data/maps/GoldenrodCity_GameCorner_hns/scripts.inc:827
msgid "Play VOLTORB Flip Lv. {STR_VAR_1}?"
msgstr "Jouer à Voltorbataille niveau\\n{STR_VAR_1}?"

#. source : patch FR actuel
#: data/maps/GoldenrodCity_GameCorner_hns/scripts.inc:830
msgid "Game clear!\\pYou've found all the hidden\\nx2 and x3 cards!"
msgstr "Partie gagnée!\\pVous avez trouvé toutes les\\ncartes x2 et x3 cachées!"

#. source : patch FR actuel
#: data/maps/GoldenrodCity_GameCorner_hns/scripts.inc:835
msgid "You have received\\n{STR_VAR_1} Coin(s)!"
msgstr "Vous recevez\\n{STR_VAR_1} Jeton(s)!"

#. source : SoulSilver FR officiel
#. lot : B_soulsilver
#. preuve : 39:41 — Le jeu est monté au niveau {STRVAR_1 50, 0, 0}!\r
#. ancien (patch FR actuel) : Passage au niveau {STR_VAR_1}!
#: data/maps/GoldenrodCity_GameCorner_hns/scripts.inc:839
msgid "Advanced to Game Lv. {STR_VAR_1}!"
msgstr "Le jeu est monté au niveau\\n{STR_VAR_1}!"

#. source : SoulSilver FR officiel
#. patch FR actuel : Oh non! Vous gagnez 0 Jeton!
#: data/maps/GoldenrodCity_GameCorner_hns/scripts.inc:842
msgid "Oh no! You get 0 Coins!"
msgstr "Dommage! Vous avez 0 Jeton!"

#. source : SoulSilver FR officiel
#. lot : B_soulsilver
#. preuve : 39:43 — Le jeu est descendu au niveau {STRVAR_1 50, 0, 0}!\r
#. ancien (patch FR actuel) : Retour au niveau {STR_VAR_1}.
