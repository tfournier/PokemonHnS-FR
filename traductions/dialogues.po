msgid "TRAINER TIPS\\pWin a free HM for finding the\\nSECRET HOUSE."
msgstr "Astuce\\pDécouvrez la Cabane Secrète et\\ngagnez une CS!"

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x175953 (pokefirered SilphCo_4F_Text_CantYouSeeImHiding,
#. BPRE 0x1759F5, ptr) : Chut!\nTu n’vois pas que je me cache?
#. ancien (traduction nouvelle) : Chut!\nTu vois pas que je me cache?
#: data/maps/SilphCo_4F_Frlg/scripts.inc:43
msgid "Sssh!\\nCan't you see I'm hiding?"
msgstr "Chut!\\nTu n’vois pas que je me cache?"

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x175978 (pokefirered SilphCo_4F_Text_TeamRocketIsGone, BPRE
#. 0x175A15, ptr) : La TEAM ROCKET est partie? COOL!
#. ancien (traduction nouvelle) : Hein?\nLa Team Rocket est partie?
#: data/maps/SilphCo_4F_Frlg/scripts.inc:47
