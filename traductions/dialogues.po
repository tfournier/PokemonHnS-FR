msgstr "Cette île est trop vaste… Il\\nfaut des heures pour patrouiller…"

#. source : traduction nouvelle
#. lot : D1_dialogues
#: data/text/trainers_frlg.inc:931
msgid "I don't forgive people who abuse\\nPOKéMON!"
msgstr "Je ne pardonne pas à ceux qui\\nmaltraitent les Pokémon!"

#. source : Rouge Feu FR officiel (adapté)
#. lot : F_frlg
#. preuve : BPRF 0x1C2BAF (pokefirered
#. SevenIsland_SevaultCanyon_Entrance_Text_EveRematchIntro, BPRE 0x1C4416,
