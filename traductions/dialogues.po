msgstr "La Team Rocket est partie? COOL!"

#. source : Rouge Feu FR officiel (adapté)
#. lot : F_frlg
#. preuve : BPRF 0x175999 (pokefirered SilphCo_4F_Text_Grunt1Intro, BPRE
#. 0x175A2F, ptr) : La TEAM ROCKET contrôle\nla SYLPHE SARL!!!
#. ancien (traduction nouvelle) : La Team Rocket a pris le contrôle\nde la
#. Sylphe SARL!
#: data/maps/SilphCo_4F_Frlg/scripts.inc:51
msgid "TEAM ROCKET has taken control\\nof SILPH CO.!"
msgstr "La Team Rocket contrôle\\nla Sylphe SARL!!!"

#. source : SoulSilver FR officiel
#: data/maps/SilphCo_4F_Frlg/scripts.inc:55
msgid "Arrgh!"
msgstr "Waaah!"

#. source : Rouge Feu FR officiel (adapté)
#. lot : F_frlg
#. preuve : BPRF 0x1759CA (pokefirered SilphCo_4F_Text_Grunt1PostBattle, BPRE
#. 0x175A62, ptr) : Le BOSS attend ce moment depuis\nlongtemps!
#. ancien (traduction nouvelle) : Fwahahaha!\nMon Boss convoitait cet endroit!
#: data/maps/SilphCo_4F_Frlg/scripts.inc:58
msgid "Fwahahaha!\\nMy BOSS has been after this place!"
msgstr "Le Boss attend ce moment depuis\\nlongtemps!"

#. source : Rouge Feu FR officiel (adapté)
#. lot : F_frlg
#. preuve : BPRF 0x1759F5 (pokefirered SilphCo_4F_Text_RodneyIntro, BPRE
#. 0x175A90, ptr) : Mes POKéMON me servent\nloyalement!!!
#. ancien (traduction nouvelle) : Mon Pokémon est mon fidèle serviteur.
#: data/maps/SilphCo_4F_Frlg/scripts.inc:62
msgid "My POKéMON is my loyal servant."
msgstr "Mes Pokémon me servent loyalement!!!"

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x175A1A (pokefirered SilphCo_4F_Text_RodneyDefeat, BPRE
#. 0x175AB0, ptr) : NAN!\nSaleté de POKéMON!
#. ancien (traduction nouvelle) : Zut!\nPokémon minable!
#: data/maps/SilphCo_4F_Frlg/scripts.inc:65
msgid "Darn!\\nYou weak POKéMON!"
msgstr "NAN!\\nSaleté de Pokémon!"

#. source : Rouge Feu FR officiel (adapté)
#. lot : F_frlg
#. preuve : BPRF 0x175A32 (pokefirered SilphCo_4F_Text_RodneyPostBattle, BPRE
#. 0x175AC8, ptr) : Les portes sont sécurisées!\pIl te faut une CARTE MAGN.
#. pour\nles ouvrir!
#. ancien (traduction nouvelle) : Les portes sont
#. verrouillées\nélectroniquement.\pIl faut une Carte Magnétique pour\nouvrir
#. les portes, ici.
#: data/maps/SilphCo_4F_Frlg/scripts.inc:69
msgid ""
"The doors are electronically\\nlocked.\\pIt takes a CARD KEY to open "
"the\\ndoors here."
msgstr ""
"Les portes sont sécurisées!\\pIl te faut une Carte Magn. pour\\nles ouvrir!"

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x175A7A (pokefirered SilphCo_4F_Text_Grunt2Intro, BPRE
#. 0x175B19, ptr) : J’ai repéré un intrus!
#. ancien (traduction nouvelle) : Intrus repéré!
#: data/maps/SilphCo_4F_Frlg/scripts.inc:75
msgid "Intruder spotted!"
msgstr "J’ai repéré un intrus!"

#. source : SoulSilver FR officiel
#: data/maps/DragonsDen_Cavern_hns/scripts.inc:268
#: data/maps/SilphCo_4F_Frlg/scripts.inc:78
msgid "Who are you?"
msgstr "Qui es-tu?"

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x175AA2 (pokefirered SilphCo_4F_Text_Grunt2PostBattle, BPRE
#. 0x175B38, ptr) : Je dois prévenir le chef au 10ème\nétage!
#. ancien (traduction nouvelle) : Je vais prévenir le Boss au 10e étage!
#: data/maps/SilphCo_4F_Frlg/scripts.inc:81
msgid "I better tell the BOSS on 11F!"
msgstr "Je dois prévenir le chef au 10ème\\nétage!"

