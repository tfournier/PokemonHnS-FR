#: data/maps/BattleFrontier_BattleTowerMultiPartnerRoom/scripts.inc:502
#: data/maps/BattleFrontier_BattleTowerMultiPartnerRoom_hns/scripts.inc:502
msgid ""
"one {STR_VAR_2} with {STR_VAR_1}.\\nOf course I raised them superbly!\\pSo, "
"want to team up?\\nI'm sure it'll be a great combo!"
msgstr ""
"et un {STR_VAR_2} avec {STR_VAR_1}.\\nJe les ai bien dressés!\\pTu veux "
"qu’on fasse équipe?\\nJe suis sûre qu’on ira bien ensemble!"

#. source : Émeraude FR officiel
#: data/maps/BattleFrontier_BattleTowerMultiPartnerRoom/scripts.inc:508
#: data/maps/BattleFrontier_BattleTowerMultiPartnerRoom_hns/scripts.inc:508
