msgstr "Safrania\\nGare du Train Magnétique"

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x1790F7 (pokefirered RockTunnel_1F_Text_LennyIntro, BPRE
#. 0x179366, ptr) : Il est long ce tunnel, oh oui!
#. ancien (traduction nouvelle) : Ce tunnel est très long, gamin!
#: data/maps/RockTunnel_1F_Frlg/scripts.inc:49
msgid "This tunnel goes a long way, kid!"
msgstr "Il est long ce tunnel, oh oui!"

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x179116 (pokefirered RockTunnel_1F_Text_LennyDefeat, BPRE
#. 0x179388, ptr) : Rôooh!\nT’as gagné!
#. ancien (traduction nouvelle) : Oh!\nT’as gagné!
#: data/maps/RockTunnel_1F_Frlg/scripts.inc:52
msgid "Doh!\\nYou win!"
msgstr "Rôooh!\\nT’as gagné!"

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x179129 (pokefirered RockTunnel_1F_Text_LennyPostBattle,
#. BPRE 0x179396, ptr) : Attention aux ONIX!\nIls apparaissent souvent
#. ici.\pIls pourraient facilement \nt’écrabouiller, fais attention!
#. ancien (traduction nouvelle) : Fais attention aux ONIX. Ils\nn’apparaissent
#. que de temps en temps.\pCeux de haut niveau peuvent te\nserrer très fort!
#: data/maps/RockTunnel_1F_Frlg/scripts.inc:56
msgid ""
"Watch for ONIX.\\nThey appear only occasionally.\\pHigh-level ones can put "
"the\\nsqueeze on you!"
msgstr ""
"Attention aux ONIX!\\nIls apparaissent souvent ici.\\pIls pourraient "
"facilement \\nt’écrabouiller, fais attention!"

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x179196 (pokefirered RockTunnel_1F_Text_OliverIntro, BPRE
#. 0x1793F1, ptr) : Bon, bon, bon, je suis perdu…
#. ancien (traduction nouvelle) : Hmm.\nJe me suis peut-être perdu…
#: data/maps/RockTunnel_1F_Frlg/scripts.inc:62
msgid "Hmm.\\nMaybe I'm lost in here…"
msgstr "Bon, bon, bon, je suis perdu…"

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x1791B4 (pokefirered RockTunnel_1F_Text_OliverDefeat, BPRE
#. 0x17940E, ptr) : Hein?\nPar où je sors maintenant?
#. ancien (traduction nouvelle) : Doucement!\nQu’est-ce que je fais?\lC’est
#. par où, la sortie?
#: data/maps/RockTunnel_1F_Frlg/scripts.inc:66
msgid "Ease up!\\nWhat am I doing?\\lWhich way is out?"
msgstr "Hein?\\nPar où je sors maintenant?"

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x1791D5 (pokefirered RockTunnel_1F_Text_OliverPostBattle,
#. BPRE 0x17943A, ptr) : Ce POKéMON endormi sur la route 12\nm’a obligé à
#. faire un détour.
#. ancien (traduction nouvelle) : Ce Pokémon endormi sur la Route 12
#. m’a\nforcé à faire ce détour.
#: data/maps/RockTunnel_1F_Frlg/scripts.inc:71
msgid "That sleeping POKéMON on ROUTE 12\\nforced me to take this detour."
msgstr "Ce Pokémon endormi sur la route 12\\nm’a obligé à faire un détour."

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x179216 (pokefirered RockTunnel_1F_Text_LucasIntro, BPRE
#. 0x17947B, ptr) : Un profane comme toi me doit le\nrespect!
#. ancien (traduction nouvelle) : Les étrangers comme toi doivent me\nmontrer
#. du respect!
#: data/maps/RockTunnel_1F_Frlg/scripts.inc:75
msgid "Outsiders like you need to show me\\nsome respect!"
msgstr "Un profane comme toi me doit le\\nrespect!"

#. source : patch FR actuel
#: data/maps/RockTunnel_1F_Frlg/scripts.inc:79
#: data/maps/Route35_hns/scripts.inc:116
msgid "I give!"
msgstr "Je me rends!"

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x179246 (pokefirered RockTunnel_1F_Text_LucasPostBattle,
#. BPRE 0x1794B4, ptr) : Tu as le niveau des meilleurs\nmontagnards!
