#: data/maps/SixIsland_RuinValley_Frlg/scripts.inc:118
#: data/text/trainers_frlg.inc:907
msgid "I'm pretty familiar with the land\\naround these parts."
msgstr "Je connais bien le coin et ses\\nmystères."

#. source : Rouge Feu FR officiel
#. lot : F_frlg
#. preuve : BPRF 0x18BD12 (pokefirered
#. SevenIsland_TrainerTower_Text_DarioIntro, BPRE 0x18C1ED, ptr) : Je savais
